@model MvcKutuphane.Models.AdminLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yönetici Girişi | Kütüphane</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --oxblood: #7a2a2e;
            --oxblood-deep: #5b1f22;
            --forest: #2f4a3e;
            --brass: #a9793b;
            --brass-light: #d4a960;
            --ink: #241c19;
            --ink-soft: #6f6259;
            --surface: #ffffff;
            --surface-warm: #faf6f0;
            --border: #e7ddd0;
            --border-strong: #d8c9b4;
            --radius-s: 8px;
            --radius-m: 14px;
            --shadow-card: 0 18px 40px rgba(36, 28, 25, 0.18);
            --font-display: 'Playfair Display', Georgia, serif;
            --font-body: 'Inter', -apple-system, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            font-family: var(--font-body);
            color: var(--ink);
            display: flex;
            min-height: 100vh;
            background: var(--surface-warm);
        }

        .login-shell {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* Left panel — library brand side */
        .brand-panel {
            position: relative;
            flex: 1.1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 56px 60px;
            background: radial-gradient(circle at 20% 20%, rgba(169,121,59,0.25), transparent 55%), linear-gradient(160deg, var(--oxblood-deep) 0%, #3a1416 60%, #201012 100%);
            color: var(--surface-warm);
            overflow: hidden;
        }

            .brand-panel::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient(90deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 34px);
                pointer-events: none;
            }

        .brand-mark {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.25rem;
            letter-spacing: 0.02em;
            z-index: 1;
        }

            .brand-mark svg {
                width: 30px;
                height: 30px;
                color: var(--brass-light);
                flex-shrink: 0;
            }

        .brand-quote {
            z-index: 1;
            max-width: 420px;
        }

            .brand-quote p.line {
                font-family: var(--font-display);
                font-size: 1.7rem;
                line-height: 1.42;
                margin: 0 0 18px;
                font-weight: 600;
            }

            .brand-quote .attribution {
                font-size: 0.85rem;
                letter-spacing: 0.06em;
                text-transform: uppercase;
                color: rgba(250, 246, 240, 0.6);
            }

        .brand-foot {
            z-index: 1;
            display: flex;
            gap: 28px;
            font-size: 0.8rem;
            color: rgba(250, 246, 240, 0.55);
        }

        /* Right panel — form side */
        .form-panel {
            flex: 1;
            min-width: 380px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 32px;
            background: var(--surface-warm);
        }

        .login-card {
            width: 100%;
            max-width: 380px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-m);
            box-shadow: var(--shadow-card);
            padding: 44px 40px 36px;
        }

            .login-card .kicker {
                font-size: 0.76rem;
                font-weight: 600;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--brass);
                margin: 0 0 8px;
            }

            .login-card h1 {
                font-family: var(--font-display);
                font-size: 1.6rem;
                margin: 0 0 6px;
                color: var(--ink);
            }

            .login-card .subtitle {
                font-size: 0.92rem;
                color: var(--ink-soft);
                margin: 0 0 30px;
            }

        .alert-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #f7e9e6;
            color: var(--oxblood-deep);
            border: 1px solid #edcfc9;
            border-radius: var(--radius-s);
            padding: 12px 14px;
            font-size: 0.87rem;
            margin-bottom: 22px;
        }

            .alert-error svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                margin-top: 1px;
            }

        .field-group {
            margin-bottom: 20px;
        }

            .field-group label {
                display: block;
                font-size: 0.82rem;
                font-weight: 600;
                color: var(--ink);
                margin-bottom: 7px;
            }

        .input-wrap {
            position: relative;
        }

            .input-wrap svg {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                width: 18px;
                height: 18px;
                color: var(--ink-soft);
                pointer-events: none;
            }

            .input-wrap input {
                width: 100%;
                padding: 12px 14px 12px 42px;
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-s);
                background: var(--surface);
                font-family: var(--font-body);
                font-size: 0.96rem;
                color: var(--ink);
                transition: border-color 0.15s ease, box-shadow 0.15s ease;
            }

                .input-wrap input:focus {
                    outline: none;
                    border-color: var(--oxblood);
                    box-shadow: 0 0 0 3px rgba(122, 42, 46, 0.12);
                }

            .input-wrap .toggle-pass {
                position: absolute;
                right: 12px;
                left: auto;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                pointer-events: auto;
                background: none;
                border: none;
                padding: 4px;
                color: var(--ink-soft);
            }

        .field-message {
            color: var(--oxblood);
            font-size: 0.78rem;
            margin-top: 6px;
        }

        .options-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 26px;
            font-size: 0.85rem;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink-soft);
        }

            .remember-me input {
                accent-color: var(--oxblood);
                width: 15px;
                height: 15px;
            }

        .options-row a {
            color: var(--oxblood);
            font-weight: 600;
            text-decoration: none;
        }

            .options-row a:hover {
                text-decoration: underline;
            }

        .btn-login {
            width: 100%;
            padding: 13px 16px;
            border: none;
            border-radius: var(--radius-s);
            background: linear-gradient(180deg, var(--oxblood) 0%, var(--oxblood-deep) 100%);
            color: var(--surface-warm);
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.98rem;
            letter-spacing: 0.01em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: transform 0.12s ease, box-shadow 0.12s ease;
        }

            .btn-login:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(122, 42, 46, 0.28);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .back-site {
            display: block;
            text-align: center;
            margin-top: 24px;
            font-size: 0.85rem;
            color: var(--ink-soft);
            text-decoration: none;
        }

            .back-site:hover {
                color: var(--oxblood);
            }

        @@media (max-width: 900px) {
            .brand-panel {
                display: none;
            }

            .form-panel {
                flex: 1 1 100%;
            }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="brand-panel">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 5.5C4 4.67 4.67 4 5.5 4H11V20H5.5C4.67 20 4 19.33 4 18.5V5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    <path d="M20 5.5C20 4.67 19.33 4 18.5 4H13V20H18.5C19.33 20 20 19.33 20 18.5V5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    <path d="M11 4V20" stroke="currentColor" stroke-width="1.2" />
                </svg>
                <span>Kütüphane Yönetimi</span>
            </div>

            <div class="brand-quote">
                <p class="line">"Bir kütüphane, düzenli bir zihnin yansımasıdır."</p>
                <p class="attribution">Yönetim Paneli</p>
            </div>

            <div class="brand-foot">
                <span>© @DateTime.Now.Year Kütüphane Sistemi</span>
                <span>Yalnızca yetkili personel içindir</span>
            </div>
        </div>

        <div class="form-panel">
            <div class="login-card">
                <p class="kicker">Yönetici Paneli</p>
                <h1>Tekrar hoş geldiniz</h1>
                <p class="subtitle">Devam etmek için yönetici bilgilerinizle giriş yapın.</p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert-error">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" /><path d="M12 8v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><circle cx="12" cy="16" r="0.9" fill="currentColor" /></svg>
                        <span>@TempData["Error"]</span>
                    </div>
                }

                @using (Html.BeginForm("Index", "AdminLogin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label for="KullaniciAdi">Kullanıcı adı</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 12a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="1.6" /><path d="M4.5 20a7.5 7.5 0 0115 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                            @Html.TextBoxFor(m => m.Username, new { id = "KullaniciAdi", placeholder = "Kullanıcı Adı", autocomplete = "username" })
                        </div>
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-message" })
                    </div>

                    <div class="field-group">
                        <label for="Sifre">Şifre</label>
                        <div class="input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2" stroke="currentColor" stroke-width="1.6" /><path d="M8 10.5V7.5a4 4 0 018 0v3" stroke="currentColor" stroke-width="1.6" /></svg>
                            @Html.PasswordFor(m => m.Password, new { id = "Sifre", placeholder = "••••••••", autocomplete = "current-password" })
                            <button type="button" class="toggle-pass" id="togglePass" tabindex="-1" aria-label="Şifreyi göster">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-message" })
                    </div>
                    <button type="submit" class="btn-login">
                        Giriş yap
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                }

                <a href="@Url.Action("Index", "Default")" class="back-site">← Siteye geri dön</a>
            </div>
        </div>
    </div>

    <script>(function () {
            var toggle = document.getElementById("togglePass");
            var pass = document.getElementById("Sifre");
            if (!toggle || !pass) return;
            toggle.addEventListener("click", function () {
                pass.type = pass.type === "password" ? "text" : "password";
            });
        })();</script>
</body>
</html>
