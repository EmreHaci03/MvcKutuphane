@model List<MvcKutuphane.Models.Entities.TBL_HAREKET>
@{
    ViewBag.Title = "İade Alınan Kitaplar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ret-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .ret-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .ret-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .ret-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .ret-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .ret-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .ret-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .ret-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .ret-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .ret-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .ret-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .ret-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    table.data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        overflow: hidden;
    }

        table.data-table th, table.data-table td {
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            font-size: 0.92rem;
        }

        table.data-table th {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink-soft);
            background: var(--surface-warm);
        }

        table.data-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.data-table tbody tr:hover {
            background: var(--surface-warm);
        }

    .badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 3px 10px;
        white-space: nowrap;
    }

    .badge-ontime {
        color: var(--forest);
        background: #eef3ec;
    }

    .badge-late {
        color: var(--oxblood);
        background: #f7e9e6;
    }

    .ret-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .ret-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }
</style>

<div class="ret-page-head">
    <div>
        <h1 style="margin-bottom:4px;">İade Alınan Kitaplar</h1>
        <p>Tamamlanmış ödünç işlemlerinin geçmişi.</p>
    </div>
    <a class="btn btn-ghost" href="@Url.Action("MoveBookList", "BorrowedBooks")">Aktif ödünçler</a>
</div>

<div class="ret-stats">
    <div class="ret-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam iade</div>
    </div>
    <div class="ret-stat">
        <div class="num">@(Model != null ? Model.Count(x => x.IADETARIH.HasValue && x.UYEGETIRDIGITARIH.HasValue && x.UYEGETIRDIGITARIH.Value > x.IADETARIH.Value) : 0)</div>
        <div class="label">Geç iade edilen</div>
    </div>
    <div class="ret-stat">
        <div class="num">@(Model != null ? Model.Count(x => x.IADETARIH.HasValue && x.UYEGETIRDIGITARIH.HasValue && x.UYEGETIRDIGITARIH.Value <= x.IADETARIH.Value) : 0)</div>
        <div class="label">Zamanında iade edilen</div>
    </div>
</div>

<div class="ret-toolbar">
    <div class="ret-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="retSearchInput" placeholder="Kitap, üye veya personel ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="ret-count" id="retCount">@Model.Count() kayıt listeleniyor</p>

    <div class="panel" style="padding:0; overflow-x:auto;">
        <table class="data-table" id="retTable">
            <thead>
                <tr>
                    <th>Kitap</th>
                    <th>Üye</th>
                    <th>Personel</th>
                    <th>Alış Tarihi</th>
                    <th>Teslim Taahhüdü</th>
                    <th>Gerçek İade</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    var kitapAd = h.TBL_KITAP != null ? h.TBL_KITAP.AD : "-";
                    var uyeAd = h.TBL_UYELER != null ? h.TBL_UYELER.AD + " " + h.TBL_UYELER.SOYAD : "-";
                    var personelAd = h.TBL_PERSONEL != null ? h.TBL_PERSONEL.PERSONEL : "-";
                    var gecKaldiMi = h.IADETARIH.HasValue && h.UYEGETIRDIGITARIH.HasValue && h.UYEGETIRDIGITARIH.Value > h.IADETARIH.Value;

                    <tr data-name="@((kitapAd + " " + uyeAd + " " + personelAd).ToLower())">
                        <td>@kitapAd</td>
                        <td>@uyeAd</td>
                        <td>@personelAd</td>
                        <td>@(h.ALISTARIH.Value.ToString("dd MMM yyyy"))</td>
                        <td>@(h.IADETARIH.Value.ToString("dd MMM yyyy"))</td>
                        <td>@(h.UYEGETIRDIGITARIH.HasValue ? h.UYEGETIRDIGITARIH.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td>
                            @if (gecKaldiMi)
                            {
                                <span class="badge badge-late">Geç iade</span>
                            }
                            else
                            {
                                <span class="badge badge-ontime">Zamanında</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel ret-empty">
        <h3>Henüz iade kaydı yok</h3>
        <p>Kitaplar iade alındıkça burada listelenecek.</p>
    </div>
}

<script>(function () {
        var input = document.getElementById("retSearchInput");
        var table = document.getElementById("retTable");
        var countLabel = document.getElementById("retCount");
        if (!input || !table) return;

        var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));

        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;

            rows.forEach(function (row) {
                var match = row.getAttribute("data-name").indexOf(term) !== -1;
                row.style.display = match ? "" : "none";
                if (match) visible++;
            });

            if (countLabel) countLabel.textContent = visible + " kayıt listeleniyor";
        });
    })();</script>
