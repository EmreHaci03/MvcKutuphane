@model MvcKutuphane.Models.Entities.TBL_KATEGORI
@{
    ViewBag.Title = "Kategoriyi Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .edit-layout {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .form-group input[type="text"] {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.98rem;
            color: var(--ink);
        }

            .form-group input[type="text"]:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .form-group input[readonly] {
            background: var(--surface-warm);
            color: var(--ink-soft);
            cursor: not-allowed;
        }

    .form-hint {
        font-size: 0.85rem;
        color: var(--ink-soft);
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .validation-summary-errors {
        background: #f7e9e6;
        border: 1px solid #e6c3ba;
        color: var(--oxblood-dark);
        padding: 12px 16px;
        border-radius: var(--radius-s);
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .field-validation-error {
        display: block;
        color: var(--oxblood);
        font-size: 0.85rem;
        margin-top: 6px;
    }

    input.input-validation-error {
        border-color: var(--oxblood) !important;
    }

    /* Right column */
    .side-panel {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .side-panel .panel h3 {
            font-size: 1.05rem;
            margin-bottom: 10px;
        }

    .preview-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 20px;
    }

        .preview-card .cat-id {
            font-size: 0.75rem;
            color: var(--ink-soft);
            letter-spacing: 0.03em;
            margin-bottom: 8px;
        }

        .preview-card h4 {
            font-family: var(--font-display);
            font-size: 1.2rem;
            margin: 0;
            color: var(--ink);
        }

    .tips-list {
        margin: 0;
        padding-left: 18px;
        color: var(--ink-soft);
        font-size: 0.9rem;
    }

        .tips-list li {
            margin-bottom: 10px;
            line-height: 1.5;
        }

            .tips-list li:last-child {
                margin-bottom: 0;
            }

    @@media (max-width: 900px) {
        .edit-layout {
            grid-template-columns: 1fr;
        }
    }
</style>


@if (TempData["Error"] != null)
{
    <div class="panel" style="border-left:4px solid var(--oxblood); margin-bottom:20px; color:var(--oxblood-dark);">
        @TempData["Error"]
    </div>
}
<h1 style="margin-bottom:4px;">Kategoriyi Düzenle</h1>
<p style="color:var(--ink-soft); margin-bottom:28px;">"@Model.CategoryName" kategorisinin bilgilerini güncelleyin.</p>

<div class="edit-layout">

    <div class="panel">
        @using (Html.BeginForm("UpdateCategory", "Category", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                <label>Kategori No</label>
                <input type="text" value="@Model.ID" readonly />
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CategoryName, "Kategori Adı")
                @Html.TextBoxFor(m => m.CategoryName, new { @class = "input-text", id = "categoryNameInput", placeholder = "Örn: Roman, Bilim Kurgu, Tarih", autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.CategoryName, "", new { @class = "field-validation-error" })
                <p class="form-hint">Bu ad, kitap listelerinde ve filtrelerde kategori adı olarak görünecektir.</p>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
                <a class="btn btn-ghost" href="@Url.Action("Index", "Category")">Vazgeç</a>
            </div>
        }
    </div>

    <div class="side-panel">
        <div class="panel">
            <h3>Kategori önizleme</h3>
            <p style="color:var(--ink-soft); font-size:0.88rem; margin-bottom:16px;">Kitap kataloğu listesinde bu şekilde görünecek.</p>
            <div class="preview-card">
                <div class="cat-id">Kategori No: @Model.ID</div>
                <h4 id="previewName">@Model.CategoryName</h4>
            </div>
        </div>

        <div class="panel">
            <h3>Dikkat edilmesi gerekenler</h3>
            <ul class="tips-list">
                <li>Kategori adını değiştirmek, bu kategoriye bağlı tüm kitapların listelerde göründüğü etiketi de değiştirir.</li>
                <li>Kısa ve net isimler tercih edin — örn. "Bilim Kurgu" yerine uzun açıklamalar yazmayın.</li>
                <li>Aynı isimde birden fazla kategori oluşturmamaya dikkat edin, aksi halde kitaplar dağınık görünür.</li>
            </ul>
        </div>
    </div>

</div>

<script>
    (function () {
        var input = document.getElementById("categoryNameInput");
        var preview = document.getElementById("previewName");
        if (!input || !preview) return;

        input.addEventListener("input", function () {
            preview.textContent = input.value.trim() === "" ? "(isimsiz kategori)" : input.value;
        });
    })();</script>
