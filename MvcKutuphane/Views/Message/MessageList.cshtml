@model List<MvcKutuphane.Models.Entities.TBL_MESAJ>
@using System.Web
@{
    ViewBag.Title = "Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .msg-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .msg-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .msg-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .msg-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .msg-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .msg-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .msg-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .msg-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .msg-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .msg-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .msg-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .msg-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .msg-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .msg-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 20px 22px;
        box-shadow: var(--shadow-card);
    }

    .msg-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 10px;
    }

    .msg-sender {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .msg-avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--oxblood);
        color: var(--surface-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .msg-sender .t1 {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
        font-size: 0.98rem;
    }

    .msg-sender .t2 {
        font-size: 0.82rem;
        color: var(--ink-soft);
    }

    .msg-subject-tag {
        display: inline-block;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--forest);
        background: #eef3ec;
        border-radius: 999px;
        padding: 3px 12px;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .msg-body {
        color: var(--ink-soft);
        font-size: 0.92rem;
        line-height: 1.6;
        margin: 12px 0 16px;
        padding-left: 50px;
    }

    .msg-actions {
        display: flex;
        gap: 16px;
        padding-left: 50px;
    }

        .msg-actions a, .msg-actions button {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--forest);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            font-family: var(--font-body);
        }

            .msg-actions button.danger {
                color: var(--oxblood);
            }

            .msg-actions a:hover, .msg-actions button:hover {
                text-decoration: underline;
            }

    .msg-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .msg-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(42, 33, 28, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-box {
        background: var(--surface);
        border-radius: var(--radius-m);
        max-width: 420px;
        width: 100%;
        padding: 28px;
        box-shadow: 0 20px 60px -12px rgba(42, 33, 28, 0.45);
        border-top: 4px solid var(--oxblood);
    }

    .modal-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f7e9e6;
        color: var(--oxblood);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .modal-icon svg {
            width: 22px;
            height: 22px;
        }

    .modal-box h3 {
        margin-bottom: 8px;
    }

    .modal-box p {
        color: var(--ink-soft);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .modal-box p strong {
            color: var(--ink);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-danger {
        background: var(--oxblood);
        color: var(--surface-warm);
        border-color: var(--oxblood);
    }

        .btn-danger:hover {
            background: var(--oxblood-dark);
        }
</style>

@if (TempData["Error"] != null)
{
    <div class="panel" style="border-left:4px solid var(--oxblood); margin-bottom:20px; color:var(--oxblood-dark);">
        @TempData["Error"]
    </div>
}
@if (TempData["Message"] != null)
{
    <div class="panel" style="border-left:4px solid var(--forest); margin-bottom:20px; color:var(--forest);">
        @TempData["Message"]
    </div>
}

<div class="msg-page-head">
    <div>
        <h1 style="margin-bottom:4px;">Mesajlar</h1>
        <p>İletişim formundan gelen mesajlar.</p>
    </div>
</div>

<div class="msg-stats">
    <div class="msg-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam mesaj</div>
    </div>
</div>

<div class="msg-toolbar">
    <div class="msg-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="msgSearchInput" placeholder="İsim, e-posta veya konuya göre ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="msg-count" id="msgCount">@Model.Count() mesaj listeleniyor</p>

    <div class="msg-list" id="msgList">
        @foreach (var m in Model)
        {
            var initials = !string.IsNullOrWhiteSpace(m.ADSOYAD) ? m.ADSOYAD.Trim().Substring(0, 1).ToUpper() : "?";

            <div class="msg-card" data-name="@((m.ADSOYAD + " " + m.MAIL + " " + m.KONU).ToLower())">
                <div class="msg-card-head">
                    <div class="msg-sender">
                        <div class="msg-avatar">@initials</div>
                        <div>
                            <div class="t1">@m.ADSOYAD</div>
                            <div class="t2">@m.MAIL</div>
                        </div>
                    </div>
                    <span class="msg-subject-tag">@m.KONU</span>
                </div>

                <p class="msg-body">@m.MESAJ</p>

                <div class="msg-actions">
                    <a href="mailto:@m.MAIL?subject=RE: @m.KONU">Yanıtla</a>
                    <button type="button" class="danger" onclick="openDeleteModal('@m.ID', '@Html.Raw(HttpUtility.JavaScriptStringEncode(m.ADSOYAD))')">Sil</button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="panel msg-empty">
        <h3>Henüz mesaj yok</h3>
        <p>İletişim formundan gelen mesajlar burada listelenecek.</p>
    </div>
}

<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M10.3 3.86 2.7 18a1.5 1.5 0 0 0 1.3 2.25h16a1.5 1.5 0 0 0 1.3-2.25L13.7 3.86a1.5 1.5 0 0 0-2.6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Mesajı sil</h3>
        <p><strong id="deleteModalMsgName"></strong> adlı kişiden gelen mesajı silmek istediğinize emin misiniz?</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Vazgeç</button>
            @using (Html.BeginForm("DeleteMessage", "Message", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteMsgId" value="" />
                <button type="submit" class="btn btn-danger">Evet, sil</button>
            }
        </div>
    </div>
</div>

<script>(function () {
        var input = document.getElementById("msgSearchInput");
        var list = document.getElementById("msgList");
        var countLabel = document.getElementById("msgCount");
        if (!input || !list) return;

        var cards = Array.prototype.slice.call(list.querySelectorAll(".msg-card"));

        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;
            cards.forEach(function (card) {
                var match = card.getAttribute("data-name").indexOf(term) !== -1;
                card.style.display = match ? "" : "none";
                if (match) visible++;
            });
            if (countLabel) countLabel.textContent = visible + " mesaj listeleniyor";
        });
    })();

    var deleteModal = document.getElementById("deleteModal");
    function openDeleteModal(id, name) {
        document.getElementById("deleteMsgId").value = id;
        document.getElementById("deleteModalMsgName").textContent = name;
        deleteModal.classList.add("is-open");
    }
    function closeDeleteModal() { deleteModal.classList.remove("is-open"); }
    deleteModal.addEventListener("click", function (e) { if (e.target === deleteModal) closeDeleteModal(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDeleteModal(); });</script>
