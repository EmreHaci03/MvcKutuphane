@model List<MvcKutuphane.Models.Entities.TBL_KATEGORI>
@{
    ViewBag.Title = "Kategoriler";
    ViewBag.Lede = "İlgi alanınıza göre koleksiyonu keşfedin.";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .cat-toolbar {
        display: flex;
        margin-bottom: 32px;
    }

    .cat-search {
        flex: 1;
        max-width: 420px;
        position: relative;
    }

        .cat-search input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.98rem;
            color: var(--ink);
        }

            .cat-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .cat-search svg {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            color: var(--ink-soft);
        }

    .public-cat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 20px;
    }

    .public-cat-card {
        display: block;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 24px;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-left-color 0.18s ease;
    }

        .public-cat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-card);
            border-left-color: var(--oxblood);
        }

    .public-cat-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--surface-warm);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--oxblood);
        margin-bottom: 16px;
    }

        .public-cat-icon svg {
            width: 18px;
            height: 18px;
        }

    .public-cat-card h3 {
        font-size: 1.1rem;
        margin-bottom: 6px;
        color: var(--ink);
    }

    .public-cat-card .count {
        font-size: 0.85rem;
        color: var(--ink-soft);
    }

    .cat-empty {
        text-align: center;
        padding: 70px 20px;
        color: var(--ink-soft);
    }

        .cat-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }
</style>

<div class="cat-toolbar">
    <div class="cat-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="catSearchInput" placeholder="Kategori ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="public-cat-grid" id="catGrid">
        @foreach (var kategori in Model)
        {
            var kitapSayisi = kategori.TBL_KITAP != null ? kategori.TBL_KITAP.Count : 0;

            <a class="public-cat-card" data-name="@kategori.CategoryName.ToLower()" href="@Url.Action("BookListWithCategory", new { id = kategori.ID })">
                <div class="public-cat-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.6">
                        <path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5C4.7 20 4 19.3 4 18.5v-13Z" />
                        <path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5c.8 0 1.5-.7 1.5-1.5v-13Z" />
                    </svg>
                </div>
                <h3>@kategori.CategoryName</h3>
                <p class="count">@kitapSayisi kitap</p>
            </a>
        }
    </div>
}
else
{
    <div class="cat-empty">
        <h3>Henüz kategori eklenmemiş</h3>
        <p>Koleksiyon kategorileri yakında burada listelenecek.</p>
    </div>
}

<script>(function () {
        var input = document.getElementById("catSearchInput");
        var grid = document.getElementById("catGrid");
        if (!input || !grid) return;

        var cards = Array.prototype.slice.call(grid.querySelectorAll(".public-cat-card"));

        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            cards.forEach(function (card) {
                var match = card.getAttribute("data-name").indexOf(term) !== -1;
                card.style.display = match ? "" : "none";
            });
        });
    })();</script>
