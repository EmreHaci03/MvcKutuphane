@model List<MvcKutuphane.Models.Entities.TBL_HAREKET>
@using System.Web
@{
    ViewBag.Title = "Ödünç İşlemleri";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .loan-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .loan-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .loan-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .loan-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .loan-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .loan-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .loan-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .loan-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .loan-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .loan-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .loan-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .loan-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    table.data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        overflow: hidden;
    }

        table.data-table th, table.data-table td {
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            font-size: 0.92rem;
        }

        table.data-table th {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink-soft);
            background: var(--surface-warm);
        }

        table.data-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.data-table tbody tr:hover {
            background: var(--surface-warm);
        }

    .badge {
        display: inline-block;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 999px;
        padding: 3px 10px;
        white-space: nowrap;
    }

    .badge-active {
        color: var(--forest);
        background: #eef3ec;
    }

    .badge-overdue {
        color: #ffffff;
        background: var(--oxblood);
    }

    .row-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

        .row-actions a, .row-actions button {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--forest);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            font-family: var(--font-body);
            white-space: nowrap;
        }

            .row-actions button.danger {
                color: var(--oxblood);
            }

            .row-actions button.success {
                color: var(--brass);
            }

            .row-actions a:hover, .row-actions button:hover {
                text-decoration: underline;
            }

    .loan-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .loan-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(42, 33, 28, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-box {
        background: var(--surface);
        border-radius: var(--radius-m);
        max-width: 420px;
        width: 100%;
        padding: 28px;
        box-shadow: 0 20px 60px -12px rgba(42, 33, 28, 0.45);
        border-top: 4px solid var(--oxblood);
    }

        .modal-box.confirm-ok {
            border-top-color: var(--forest);
        }

    .modal-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f7e9e6;
        color: var(--oxblood);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .modal-icon.ok {
            background: #eef3ec;
            color: var(--forest);
        }

        .modal-icon svg {
            width: 22px;
            height: 22px;
        }

    .modal-box h3 {
        margin-bottom: 8px;
    }

    .modal-box p {
        color: var(--ink-soft);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .modal-box p strong {
            color: var(--ink);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-danger {
        background: var(--oxblood);
        color: var(--surface-warm);
        border-color: var(--oxblood);
    }

        .btn-danger:hover {
            background: var(--oxblood-dark);
        }

    .btn-success {
        background: var(--forest);
        color: var(--surface-warm);
        border-color: var(--forest);
    }

        .btn-success:hover {
            background: #24382e;
        }
</style>

@if (TempData["Error"] != null)
{
    <div class="panel" style="border-left:4px solid var(--oxblood); margin-bottom:20px; color:var(--oxblood-dark);">
        @TempData["Error"]
    </div>
}
@if (TempData["Message"] != null)
{
    <div class="panel" style="border-left:4px solid var(--forest); margin-bottom:20px; color:var(--forest);">
        @TempData["Message"]
    </div>
}

<div class="loan-page-head">
    <div>
        <h1 style="margin-bottom:4px;">Ödünç İşlemleri</h1>
        <p>Kitapların ödünç alma kayıtları.</p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("CreateLend", "BorrowedBooks")">Yeni ödünç ver</a>
</div>

<div class="loan-stats">
    <div class="loan-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam işlem</div>
    </div>
    <div class="loan-stat">
        <div class="num">@(Model != null ? Model.Count(x => x.IADETARIH >= DateTime.Now) : 0)</div>
        <div class="label">Süresi devam eden</div>
    </div>
    <div class="loan-stat">
        <div class="num">@(Model != null ? Model.Count(x => x.IADETARIH < DateTime.Now) : 0)</div>
        <div class="label">Süresi geçmiş</div>
    </div>
</div>

<div class="loan-toolbar">
    <div class="loan-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="loanSearchInput" placeholder="Kitap, üye veya personel ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="loan-count" id="loanCount">@Model.Count() kayıt listeleniyor</p>

    <div class="panel" style="padding:0; overflow-x:auto;">
        <table class="data-table" id="loanTable">
            <thead>
                <tr>
                    <th>Kitap</th>
                    <th>Üye</th>
                    <th>Personel</th>
                    <th>Alış Tarihi</th>
                    <th>Teslim Tarihi</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model)
                {
                    var kitapAd = h.TBL_KITAP != null ? h.TBL_KITAP.AD : "-";
                    var uyeAd = h.TBL_UYELER != null ? h.TBL_UYELER.AD + " " + h.TBL_UYELER.SOYAD : "-";
                    var personelAd = h.TBL_PERSONEL != null ? h.TBL_PERSONEL.PERSONEL : "-";
                    var ozet = kitapAd + " - " + uyeAd;

                    var isOverdue = h.IADETARIH.HasValue && h.IADETARIH.Value < DateTime.Now;

                    <tr data-name="@((kitapAd + " " + uyeAd + " " + personelAd).ToLower())">
                        <td>@kitapAd</td>
                        <td>@uyeAd</td>
                        <td>@personelAd</td>
                        <td>@(h.ALISTARIH.HasValue ? h.ALISTARIH.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td>@(h.IADETARIH.HasValue ? h.IADETARIH.Value.ToString("dd MMM yyyy") : "-")</td>
                        <td>
                            @if (isOverdue)
                            {
                                <span class="badge badge-overdue">Süresi geçti</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Ödünçte</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <button type="button" class="success" onclick="openReturnModal('@h.ID', '@Html.Raw(HttpUtility.JavaScriptStringEncode(ozet))')">İade al</button>
                                <a href="@Url.Action("UpdateLend", "BorrowedBooks", new { id = h.ID })">Düzenle</a>
                                <button type="button" class="danger" onclick="openDeleteModal('@h.ID', '@Html.Raw(HttpUtility.JavaScriptStringEncode(ozet))')">Sil</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel loan-empty">
        <h3>Henüz ödünç kaydı yok</h3>
        <p>İlk ödünç işlemini oluşturarak başlayın.</p>
        <a class="btn btn-primary" href="@Url.Action("CreateLend", "BorrowedBooks")" style="margin-top:12px;">Yeni ödünç ver</a>
    </div>
}

<!-- Silme onay modalı -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M10.3 3.86 2.7 18a1.5 1.5 0 0 0 1.3 2.25h16a1.5 1.5 0 0 0 1.3-2.25L13.7 3.86a1.5 1.5 0 0 0-2.6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Kaydı sil</h3>
        <p><strong id="deleteModalLoanName"></strong> işlemini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Vazgeç</button>
            @using (Html.BeginForm("DeleteLend", "BorrowedBooks", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteLoanId" value="" />
                <button type="submit" class="btn btn-danger">Evet, sil</button>
            }
        </div>
    </div>
</div>

<!-- İade onay modalı -->
<div class="modal-overlay" id="returnModal">
    <div class="modal-box confirm-ok">
        <div class="modal-icon ok">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Kitabı iade al</h3>
        <p><strong id="returnModalLoanName"></strong> kaydını iade alınmış olarak işaretlemek istediğinize emin misiniz? Kitap tekrar rafta mevcut olarak işaretlenecek.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeReturnModal()">Vazgeç</button>
            @using (Html.BeginForm("ReturnBook", "BorrowedBooks", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="returnLoanId" value="" />
                <button type="submit" class="btn btn-success">Evet, iade alındı</button>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById("loanSearchInput");
        var table = document.getElementById("loanTable");
        var countLabel = document.getElementById("loanCount");
        if (!input || !table) return;

        var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));

        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;

            rows.forEach(function (row) {
                var match = row.getAttribute("data-name").indexOf(term) !== -1;
                row.style.display = match ? "" : "none";
                if (match) visible++;
            });

            if (countLabel) countLabel.textContent = visible + " kayıt listeleniyor";
        });
    })();

    var deleteModal = document.getElementById("deleteModal");
    function openDeleteModal(id, name) {
        document.getElementById("deleteLoanId").value = id;
        document.getElementById("deleteModalLoanName").textContent = name;
        deleteModal.classList.add("is-open");
    }
    function closeDeleteModal() { deleteModal.classList.remove("is-open"); }
    deleteModal.addEventListener("click", function (e) { if (e.target === deleteModal) closeDeleteModal(); });

    var returnModal = document.getElementById("returnModal");
    function openReturnModal(id, name) {
        document.getElementById("returnLoanId").value = id;
        document.getElementById("returnModalLoanName").textContent = name;
        returnModal.classList.add("is-open");
    }
    function closeReturnModal() { returnModal.classList.remove("is-open"); }
    returnModal.addEventListener("click", function (e) { if (e.target === returnModal) closeReturnModal(); });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            closeDeleteModal();
            closeReturnModal();
        }
    });
</script>
