@model MvcKutuphane.Models.Entities.TBL_UYELER
@{
    ViewBag.Title = "Bilgilerimi Düzenle";
    ViewBag.Lede = "Ad, soyad, iletişim ve okul bilgilerinizi güncelleyin.";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<style>
    .edit-layout {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="tel"] {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.98rem;
            color: var(--ink);
        }

        .form-group input[readonly] {
            background: var(--surface-warm);
            color: var(--ink-soft);
            cursor: not-allowed;
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--oxblood);
        }

    .form-hint {
        font-size: 0.85rem;
        color: var(--ink-soft);
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .validation-summary-errors {
        background: #f7e9e6;
        border: 1px solid #e6c3ba;
        color: var(--oxblood-dark);
        padding: 12px 16px;
        border-radius: var(--radius-s);
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .side-panel {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .side-panel .panel h3 {
            font-size: 1.05rem;
            margin-bottom: 10px;
        }

    .preview-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 20px;
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .preview-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--oxblood);
        color: var(--surface-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .preview-card h4 {
        font-family: var(--font-display);
        font-size: 1.05rem;
        margin: 0 0 3px;
        color: var(--ink);
    }

    .preview-card p {
        font-size: 0.84rem;
        color: var(--ink-soft);
        margin: 0;
    }

    .tips-list {
        margin: 0;
        padding-left: 18px;
        color: var(--ink-soft);
        font-size: 0.9rem;
    }

        .tips-list li {
            margin-bottom: 10px;
            line-height: 1.5;
        }

    .password-note {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        background: var(--surface-warm);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 16px 18px;
    }

        .password-note svg {
            width: 20px;
            height: 20px;
            color: var(--brass);
            flex-shrink: 0;
            margin-top: 2px;
        }

        .password-note p {
            margin: 0;
            font-size: 0.88rem;
            color: var(--ink-soft);
        }

        .password-note a {
            font-weight: 600;
        }

    @@media (max-width: 900px) {
        .edit-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .form-row-2 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="edit-layout">

    <div class="panel">
        @using (Html.BeginForm("EditInformation", "MemberProfile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ID)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-row-2">
                <div class="form-group">
                    @Html.LabelFor(m => m.AD, "Ad")
                    @Html.TextBoxFor(m => m.AD, new { @class = "input-text", id = "adInput", autocomplete = "off" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.SOYAD, "Soyad")
                    @Html.TextBoxFor(m => m.SOYAD, new { @class = "input-text", id = "soyadInput", autocomplete = "off" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.MAIL, "E-posta")
                @Html.TextBoxFor(m => m.MAIL, new { @class = "input-text", type = "email", autocomplete = "off" })
                <p class="form-hint">E-posta adresinizi değiştirirseniz, bir sonraki girişte yeni adresinizi kullanmanız gerekir.</p>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FOTOGRAF, "Profil Fotoğrafı (Görsel URL)")
                @Html.TextBoxFor(m => m.FOTOGRAF, new { @class = "input-text", id = "fotografInput", placeholder = "https://ornek.com/fotograf.jpg", autocomplete = "off" })
                <p class="form-hint">Bir görsel adresi (URL) yapıştırın. Boş bırakılırsa profilinizde baş harfleriniz gösterilir.</p>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.KULLANICIADI, "Kullanıcı Adı")
                @Html.TextBoxFor(m => m.KULLANICIADI, new { @class = "input-text", autocomplete = "off" })
            </div>

            <div class="form-row-2">
                <div class="form-group">
                    @Html.LabelFor(m => m.TELEFON, "Telefon")
                    @Html.TextBoxFor(m => m.TELEFON, new { @class = "input-text", type = "tel", autocomplete = "off" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.OKUL, "Okul")
                    @Html.TextBoxFor(m => m.OKUL, new { @class = "input-text", autocomplete = "off" })
                </div>
            </div>

            <div class="password-note">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 8v4l3 3M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" stroke="currentColor" stroke-width="1.5" /></svg>
                <p>Bu sayfadan şifrenizi değiştiremezsiniz. Şifrenizi güncellemek için <a href="@Url.Action("ChangePassword", "MemberProfile")">şifre değiştirme sayfasına</a> gidin.</p>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
                <a class="btn btn-ghost" href="@Url.Action("Index", "MemberProfile")">Vazgeç</a>
            </div>
        }
    </div>

    <div class="side-panel">
        <div class="panel">
            <h3>Önizleme</h3>
            <div class="preview-card">
                <div class="preview-avatar" id="previewAvatar">@(Model.AD.Length > 0 ? Model.AD.Substring(0, 1).ToUpper() : "")@(Model.SOYAD.Length > 0 ? Model.SOYAD.Substring(0, 1).ToUpper() : "")</div>
                <div>
                    <h4 id="previewName">@Model.AD @Model.SOYAD</h4>
                    <p>Profilinizde bu isimle görünür.</p>
                </div>
            </div>
        </div>

        <div class="panel">
            <h3>Dikkat edilmesi gerekenler</h3>
            <ul class="tips-list">
                <li>E-posta adresinizi değiştirirseniz oturumunuz otomatik güncellenir, tekrar giriş yapmanız gerekmez.</li>
                <li>Kullanıcı adınızın benzersiz olduğundan emin olun.</li>
                <li>Şifre değişikliği ayrı bir sayfadan yapılır, güvenlik amacıyla burada gösterilmez.</li>
            </ul>
        </div>
    </div>

</div>

<script>(function () {
        var adInput = document.getElementById("adInput");
        var soyadInput = document.getElementById("soyadInput");
        var previewName = document.getElementById("previewName");
        var previewAvatar = document.getElementById("previewAvatar");
        if (!adInput || !soyadInput) return;

        function update() {
            var ad = adInput.value.trim();
            var soyad = soyadInput.value.trim();
            previewName.textContent = (ad + " " + soyad).trim() === "" ? "(isimsiz üye)" : (ad + " " + soyad);
            previewAvatar.textContent = ((ad.charAt(0) || "") + (soyad.charAt(0) || "")).toUpperCase();
        }

        adInput.addEventListener("input", update);
        soyadInput.addEventListener("input", update);
    })();</script>
