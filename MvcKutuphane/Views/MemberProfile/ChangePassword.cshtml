@model MvcKutuphane.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Şifre Değiştir";
    ViewBag.Lede = "Hesap güvenliğiniz için düzenli aralıklarla şifrenizi güncelleyin.";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<style>
    .password-layout {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 24px;
        align-items: start;
    }

    .password-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--border);
    }

        .password-header .icon-badge {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: var(--surface-warm);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--oxblood);
            flex-shrink: 0;
        }

            .password-header .icon-badge svg {
                width: 22px;
                height: 22px;
            }

        .password-header h3 {
            font-size: 1.1rem;
            margin-bottom: 3px;
        }

        .password-header p {
            font-size: 0.86rem;
            color: var(--ink-soft);
            margin: 0;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink);
            margin-bottom: 8px;
        }

    .password-input-wrap {
        position: relative;
    }

    .form-group input[type="password"],
    .form-group input[type="text"].pw-visible {
        width: 100%;
        padding: 11px 44px 11px 14px;
        border: 1px solid var(--border-strong);
        border-radius: var(--radius-s);
        background: var(--surface);
        font-family: var(--font-body);
        font-size: 0.98rem;
        color: var(--ink);
    }

    .form-group input:focus {
        outline: none;
        border-color: var(--oxblood);
    }

    .toggle-visibility {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--ink-soft);
        cursor: pointer;
        padding: 4px;
        display: flex;
    }

        .toggle-visibility:hover {
            color: var(--oxblood);
        }

        .toggle-visibility svg {
            width: 18px;
            height: 18px;
        }

    .form-hint {
        font-size: 0.85rem;
        color: var(--ink-soft);
        margin-top: 6px;
    }

    .strength-bar-wrap {
        display: flex;
        gap: 5px;
        margin-top: 10px;
    }

        .strength-bar-wrap .seg {
            height: 4px;
            flex: 1;
            border-radius: 2px;
            background: var(--border);
            transition: background 0.2s ease;
        }

    .strength-label {
        font-size: 0.8rem;
        color: var(--ink-soft);
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
    }

    .validation-summary-errors {
        background: #f7e9e6;
        border: 1px solid #e6c3ba;
        color: var(--oxblood-dark);
        padding: 12px 16px;
        border-radius: var(--radius-s);
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .field-validation-error {
        display: block;
        color: var(--oxblood);
        font-size: 0.85rem;
        margin-top: 6px;
    }

    input.input-validation-error {
        border-color: var(--oxblood) !important;
    }

    .side-panel {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

        .side-panel .panel h3 {
            font-size: 1.05rem;
            margin-bottom: 14px;
        }

    .security-tip {
        display: flex;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid var(--border);
    }

        .security-tip:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .security-tip:first-child {
            padding-top: 0;
        }

        .security-tip .tip-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: var(--surface-warm);
            color: var(--forest);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .security-tip .tip-icon svg {
                width: 14px;
                height: 14px;
            }

        .security-tip p {
            margin: 0;
            font-size: 0.88rem;
            color: var(--ink-soft);
            line-height: 1.5;
        }

    .last-changed-panel {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .last-changed-panel .icon-badge {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--surface-warm);
            color: var(--brass);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .last-changed-panel .icon-badge svg {
                width: 18px;
                height: 18px;
            }

        .last-changed-panel .label {
            font-size: 0.78rem;
            color: var(--ink-soft);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .last-changed-panel .value {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink);
            font-size: 1rem;
        }

    @@media (max-width: 900px) {
        .password-layout {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="password-layout">

    <div class="panel">
        <div class="password-header">
            <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.6" /><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </div>
            <div>
                <h3>Şifrenizi güncelleyin</h3>
                <p>Değişiklik sonrası tüm cihazlarda oturumunuz kapatılır.</p>
            </div>
        </div>

        @using (Html.BeginForm("ChangePassword", "MemberProfile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="form-group">
                @Html.LabelFor(m => m.Password, "Mevcut Şifre")
                <div class="password-input-wrap">
                    @Html.PasswordFor(m => m.Password, new { @class = "input-text", id = "pwCurrent", placeholder = "••••••••", autocomplete = "current-password" })
                    <button type="button" class="toggle-visibility" data-target="pwCurrent">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPassword, "Yeni Şifre")
                <div class="password-input-wrap">
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "input-text", id = "pwNew", placeholder = "••••••••", autocomplete = "new-password" })
                    <button type="button" class="toggle-visibility" data-target="pwNew">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })

                <div class="strength-bar-wrap" id="strengthBar">
                    <div class="seg"></div>
                    <div class="seg"></div>
                    <div class="seg"></div>
                    <div class="seg"></div>
                </div>
                <p class="strength-label" id="strengthLabel">En az 6 karakter olmalıdır.</p>
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.NewPasswordAgain, "Yeni Şifre (Tekrar)")
                <div class="password-input-wrap">
                    @Html.PasswordFor(m => m.NewPasswordAgain, new { @class = "input-text", id = "pwNewAgain", placeholder = "••••••••", autocomplete = "new-password" })
                    <button type="button" class="toggle-visibility" data-target="pwNewAgain">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.NewPasswordAgain, "", new { @class = "field-validation-error" })
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Şifreyi değiştir</button>
                <a class="btn btn-ghost" href="@Url.Action("Index", "MemberProfile")">Vazgeç</a>
            </div>
        }
    </div>

    <div class="side-panel">
        <div class="panel last-changed-panel">
            <div class="icon-badge">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 8v4l3 3M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" stroke="currentColor" stroke-width="1.6" /></svg>
            </div>
            <div>
                <div class="label">Son değişiklik</div>
                <div class="value">@(ViewBag.LastPasswordChange ?? "Bilinmiyor")</div>
            </div>
        </div>

        <div class="panel">
            <h3>Güçlü bir şifre için</h3>

            <div class="security-tip">
                <div class="tip-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <p>En az 8 karakter kullanın, harf ve rakamları birlikte tercih edin.</p>
            </div>

            <div class="security-tip">
                <div class="tip-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <p>Doğum tarihi, isim gibi tahmin edilmesi kolay bilgiler kullanmayın.</p>
            </div>

            <div class="security-tip">
                <div class="tip-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <p>Başka hesaplarda kullandığınız şifreleri burada tekrar kullanmayın.</p>
            </div>

            <div class="security-tip">
                <div class="tip-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </div>
                <p>Şifrenizi değiştirdikten sonra tüm cihazlarınızda tekrar giriş yapmanız gerekecek.</p>
            </div>
        </div>
    </div>

</div>

<script>(function () {
        // Şifre göster/gizle
        document.querySelectorAll(".toggle-visibility").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var target = document.getElementById(btn.getAttribute("data-target"));
                if (!target) return;
                if (target.type === "password") {
                    target.type = "text";
                    target.classList.add("pw-visible");
                } else {
                    target.type = "password";
                    target.classList.remove("pw-visible");
                }
            });
        });

        // Basit şifre gücü göstergesi
        var newPwInput = document.getElementById("pwNew");
        var segs = document.querySelectorAll("#strengthBar .seg");
        var label = document.getElementById("strengthLabel");

        function checkStrength(value) {
            var score = 0;
            if (value.length >= 6) score++;
            if (value.length >= 10) score++;
            if (/[0-9]/.test(value) && /[a-zA-Z]/.test(value)) score++;
            if (/[^a-zA-Z0-9]/.test(value)) score++;
            return score;
        }

        var colors = ["#e3d9c2", "#e3d9c2", "#e3d9c2", "#e3d9c2"];
        var strengthColors = ["#7a2a2e", "#a9793b", "#2f4a3e", "#2f4a3e"];
        var strengthTexts = ["Çok zayıf", "Zayıf", "Orta", "Güçlü"];

        if (newPwInput) {
            newPwInput.addEventListener("input", function () {
                var value = newPwInput.value;
                var score = value.length === 0 ? 0 : checkStrength(value);

                segs.forEach(function (seg, i) {
                    seg.style.background = i < score ? strengthColors[Math.max(score - 1, 0)] : "#e3d9c2";
                });

                label.textContent = value.length === 0
                    ? "En az 6 karakter olmalıdır."
                    : strengthTexts[Math.max(score - 1, 0)];
            });
        }
    })();</script>
