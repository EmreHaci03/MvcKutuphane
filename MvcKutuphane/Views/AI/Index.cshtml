@{
    ViewBag.Title = "AI Kitap Önerisi";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<style>
    .ai-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .ai-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .ai-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--brass);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .ai-eyebrow-line {
        width: 28px;
        height: 1px;
        background: var(--brass);
    }

    .ai-header h1 {
        margin: 0 0 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 2.15rem;
        line-height: 1.15;
    }

    .ai-header p {
        margin: 0;
        max-width: 650px;
        color: var(--ink-soft);
        font-size: 0.94rem;
        line-height: 1.6;
    }

    .ai-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        color: var(--forest);
        background: #eef3ec;
        border: 1px solid #dce7dd;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
    }

        .ai-badge svg {
            width: 16px;
            height: 16px;
        }

    .ai-card {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
    }

        .ai-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--forest);
        }

    .ai-card-inner {
        padding: 30px;
    }

    .ai-card-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
    }

    .ai-icon {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--forest);
        background: #edf3ee;
        border-radius: 12px;
    }

        .ai-icon svg {
            width: 25px;
            height: 25px;
        }

    .ai-card-title h2 {
        margin: 0 0 3px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.25rem;
    }

    .ai-card-title span {
        color: var(--ink-soft);
        font-size: 0.82rem;
    }

    .ai-form {
        display: flex;
        gap: 12px;
        align-items: stretch;
    }

    .ai-input {
        flex: 1;
        min-height: 56px;
        padding: 15px 18px;
        resize: vertical;
        color: var(--ink);
        background: #fbfaf7;
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
        outline: none;
        font-family: inherit;
        font-size: 0.92rem;
        line-height: 1.5;
        transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }

        .ai-input:focus {
            border-color: var(--forest);
            box-shadow: 0 0 0 3px rgba(49, 83, 62, 0.08);
        }

    .ai-button {
        min-width: 145px;
        border: 0;
        border-radius: var(--radius-s);
        color: #fff;
        background: var(--forest);
        padding: 0 22px;
        cursor: pointer;
        font-family: inherit;
        font-size: 0.84rem;
        font-weight: 700;
        transition: background 0.18s ease, transform 0.18s ease;
    }

        .ai-button:hover {
            background: #274c35;
            transform: translateY(-1px);
        }

        .ai-button svg {
            width: 17px;
            height: 17px;
            vertical-align: -4px;
            margin-right: 5px;
        }

    .ai-hints {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .ai-hint {
        padding: 6px 11px;
        color: var(--ink-soft);
        background: #f5f2ec;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.72rem;
    }

    .ai-result {
        margin-top: 18px;
        padding: 25px 28px;
        background: #fbfaf7;
        border: 1px solid var(--border);
        border-left: 4px solid var(--forest);
        border-radius: var(--radius-m);
    }

    .ai-result-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 14px;
        color: var(--forest);
        font-size: 0.74rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

        .ai-result-title svg {
            width: 17px;
            height: 17px;
        }

    .ai-answer {
        margin: 0;
        color: var(--ink);
        font-size: 0.91rem;
        line-height: 1.75;
        white-space: pre-line;
    }

    .ai-error {
        margin-top: 18px;
        padding: 14px 17px;
        color: var(--oxblood);
        background: #f7e9e6;
        border: 1px solid #edd4d0;
        border-radius: var(--radius-s);
        font-size: 0.84rem;
    }

    .ai-examples {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 18px;
    }

    .ai-example {
        padding: 16px 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
    }

        .ai-example span {
            display: block;
            margin-bottom: 7px;
            color: var(--brass);
            font-size: 0.67rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .ai-example p {
            margin: 0;
            color: var(--ink-soft);
            font-size: 0.8rem;
            line-height: 1.5;
        }

    @@media (max-width: 700px) {
        .ai-header h1 {
            font-size: 1.75rem;
        }

        .ai-card-inner {
            padding: 22px;
        }

        .ai-form {
            flex-direction: column;
        }

        .ai-button {
            min-height: 50px;
        }

        .ai-examples {
            grid-template-columns: 1fr;
        }

        .ai-badge {
            display: none;
        }
    }
</style> 

<div class="ai-page">
    <div class="ai-header">
        <div>
            <div class="ai-eyebrow">
                <span class="ai-eyebrow-line"></span>
                Member
            </div>

            <h1>AI Kitap Önerisi</h1>

            <p>
                Okuma zevklerini anlat, sana uygun kitapları yapay zekâ ile keşfedelim.
            </p>
        </div>

        <div class="ai-badge">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round" />
                <path d="M19 16l.7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round" />
            </svg>
            AI Destekli
        </div>
    </div>

    <div class="ai-card">
        <div class="ai-card-inner">

            <div class="ai-card-title">
                <div class="ai-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3a7 7 0 0 0-7 7c0 2.1.93 3.98 2.4 5.27L7 20l5-2 5 2-.4-4.73A6.97 6.97 0 0 0 19 10a7 7 0 0 0-7-7Z"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linejoin="round" />
                        <path d="M9 10h6M9 13h4"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round" />
                    </svg>
                </div>

                <div>
                    <h2>Ne okumak istersin?</h2>
                    <span>Ne aradığını doğal bir şekilde anlatabilirsin.</span>
                </div>
            </div>

            <form method="post" action="@Url.Action("Index", "AI")">

                <div class="ai-form">
                    <textarea name="userPrompt"
                              class="ai-input"
                              rows="2"
                              placeholder="Örneğin: 1984 gibi distopik ama daha akıcı bir kitap öner..."></textarea>

                    <button type="submit" class="ai-button">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M22 2 11 13"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                            <path d="m22 2-7 20-4-9-9-4 20-7Z"
                                  stroke="currentColor"
                                  stroke-width="1.7"
                                  stroke-linejoin="round" />
                        </svg>
                        Öneri Al
                    </button>
                </div>

            </form>

            <div class="ai-hints">
                <span class="ai-hint">📚 Tür belirtebilirsin</span>
                <span class="ai-hint">✍️ Sevdiğin bir kitap söyleyebilirsin</span>
                <span class="ai-hint">🌙 Atmosfer tarif edebilirsin</span>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="ai-error">
                    @ViewBag.Error
                </div>
            }

            @if (ViewBag.Answer != null)
            {
                <div class="ai-result">

                    <div class="ai-result-title">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20 6 9 17l-5-5"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
                        AI Önerisi
                    </div>

                    <p class="ai-answer">@ViewBag.Answer</p>

                </div>
            }

        </div>
    </div>

    @if (ViewBag.Answer == null)
    {
        <div class="ai-examples">

            <div class="ai-example">
                <span>Örnek 01</span>
                <p>"Harry Potter gibi fantastik ama daha karanlık bir kitap istiyorum."</p>
            </div>

            <div class="ai-example">
                <span>Örnek 02</span>
                <p>"Kısa, sürükleyici ve gizem türünde bir kitap öner."</p>
            </div>

            <div class="ai-example">
                <span>Örnek 03</span>
                <p>"1984'ü sevdim, benzer distopya kitapları öner."</p>
            </div>

        </div>
    }

</div>