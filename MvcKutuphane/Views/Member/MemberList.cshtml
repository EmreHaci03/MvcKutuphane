@model List<MvcKutuphane.Models.Entities.TBL_UYELER>
@{
    ViewBag.Title = "Üyeler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .mem-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .mem-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .mem-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .mem-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .mem-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .mem-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .mem-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .mem-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .mem-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .mem-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .mem-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .mem-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    table.data-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        overflow: hidden;
    }

        table.data-table th, table.data-table td {
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            font-size: 0.92rem;
        }

        table.data-table th {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink-soft);
            background: var(--surface-warm);
        }

        table.data-table tbody tr:last-child td {
            border-bottom: none;
        }

        table.data-table tbody tr:hover {
            background: var(--surface-warm);
        }

    .row-actions {
        display: flex;
        gap: 14px;
    }

        .row-actions a, .row-actions button {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--forest);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            font-family: var(--font-body);
            white-space: nowrap;
        }

            .row-actions button.danger {
                color: var(--oxblood);
            }

            .row-actions a:hover, .row-actions button:hover {
                text-decoration: underline;
            }

    .mem-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .mem-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(42, 33, 28, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-box {
        background: var(--surface);
        border-radius: var(--radius-m);
        max-width: 420px;
        width: 100%;
        padding: 28px;
        box-shadow: 0 20px 60px -12px rgba(42, 33, 28, 0.45);
        border-top: 4px solid var(--oxblood);
    }

    .modal-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f7e9e6;
        color: var(--oxblood);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .modal-icon svg {
            width: 22px;
            height: 22px;
        }

    .modal-box h3 {
        margin-bottom: 8px;
    }

    .modal-box p {
        color: var(--ink-soft);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .modal-box p strong {
            color: var(--ink);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-danger {
        background: var(--oxblood);
        color: var(--surface-warm);
        border-color: var(--oxblood);
    }

        .btn-danger:hover {
            background: var(--oxblood-dark);
        }
</style>

@if (TempData["Error"] != null)
{
    <div class="panel" style="border-left:4px solid var(--oxblood); margin-bottom:20px; color:var(--oxblood-dark);">
        @TempData["Error"]
    </div>
}
@if (TempData["Message"] != null)
{
    <div class="panel" style="border-left:4px solid var(--forest); margin-bottom:20px; color:var(--forest);">
        @TempData["Message"]
    </div>
}

<div class="mem-page-head">
    <div>
        <h1 style="margin-bottom:4px;">Üyeler</h1>
        <p>Kütüphaneye kayıtlı üyelerin listesi.</p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("CreateMember", "Member")">Yeni üye ekle</a>
</div>

<div class="mem-stats">
    <div class="mem-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam üye</div>
    </div>
</div>

<div class="mem-toolbar">
    <div class="mem-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="memSearchInput" placeholder="Üye ara (ad, soyad, kullanıcı adı)..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="mem-count" id="memCount">@Model.Count() üye listeleniyor</p>

    <div class="panel" style="padding:0; overflow-x:auto;">
        <table class="data-table" id="memTable">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Okul</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var uye in Model)
                {
                    var tamAd = uye.AD + " " + uye.SOYAD;
                    <tr data-name="@((tamAd + " " + uye.KULLANICIADI).ToLower())">
                        <td>@tamAd</td>
                        <td>@uye.KULLANICIADI</td>
                        <td>@uye.MAIL</td>
                        <td>@uye.TELEFON</td>
                        <td>@uye.OKUL</td>
                        <td>
                            <div class="row-actions">
                                <a href="@Url.Action("UpdateMember", "Member", new { id = uye.ID })">Düzenle</a>
                                <button type="button" class="danger" onclick="openDeleteModal('@uye.ID', '@tamAd.Replace("'", "\\'")')">Sil</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="panel mem-empty">
        <h3>Henüz üye eklenmemiş</h3>
        <p>İlk üyeyi ekleyerek başlayın.</p>
        <a class="btn btn-primary" href="@Url.Action("CreateMember", "Member")" style="margin-top:12px;">Yeni üye ekle</a>
    </div>
}

<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M10.3 3.86 2.7 18a1.5 1.5 0 0 0 1.3 2.25h16a1.5 1.5 0 0 0 1.3-2.25L13.7 3.86a1.5 1.5 0 0 0-2.6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Üyeyi sil</h3>
        <p><strong id="deleteModalMemName"></strong> adlı üyeyi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Vazgeç</button>
            @using (Html.BeginForm("DeleteMember", "Member", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteMemId" value="" />
                <button type="submit" class="btn btn-danger">Evet, sil</button>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById("memSearchInput");
        var table = document.getElementById("memTable");
        var countLabel = document.getElementById("memCount");
        if (!input || !table) return;
        var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));
        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;
            rows.forEach(function (row) {
                var match = row.getAttribute("data-name").indexOf(term) !== -1;
                row.style.display = match ? "" : "none";
                if (match) visible++;
            });
            if (countLabel) countLabel.textContent = visible + " üye listeleniyor";
        });
    })();

    var deleteModal = document.getElementById("deleteModal");
    function openDeleteModal(id, name) {
        document.getElementById("deleteMemId").value = id;
        document.getElementById("deleteModalMemName").textContent = name;
        deleteModal.classList.add("is-open");
    }
    function closeDeleteModal() { deleteModal.classList.remove("is-open"); }
    deleteModal.addEventListener("click", function (e) { if (e.target === deleteModal) closeDeleteModal(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDeleteModal(); });
</script>