@model List<MvcKutuphane.Models.Entities.TBL_YAZAR>
@{
    ViewBag.Title = "Yazarlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .auth-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .auth-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .auth-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .auth-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .auth-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .auth-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .auth-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .auth-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .auth-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .auth-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .auth-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .auth-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .auth-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .auth-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
        display: flex;
        align-items: flex-start;
        gap: 16px;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

        .auth-card:hover {
            transform: translateY(-2px);
            border-color: var(--brass);
        }

    .auth-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--oxblood);
        color: var(--surface-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        flex-shrink: 0;
    }

    .auth-body {
        flex: 1;
        min-width: 0;
    }

        .auth-body .auth-id {
            font-size: 0.75rem;
            color: var(--ink-soft);
            letter-spacing: 0.03em;
            margin-bottom: 4px;
        }

        .auth-body h3 {
            margin: 0 0 6px;
            font-size: 1.15rem;
        }

        .auth-body .auth-detay {
            color: var(--ink-soft);
            font-size: 0.92rem;
            margin: 0;
            max-width: 62ch;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    .auth-actions {
        display: flex;
        gap: 14px;
        flex-shrink: 0;
        padding-top: 4px;
    }

        .auth-actions a,
        .auth-actions button {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--forest);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            font-family: var(--font-body);
            white-space: nowrap;
        }

            .auth-actions button.danger {
                color: var(--oxblood);
            }

            .auth-actions a:hover,
            .auth-actions button:hover {
                text-decoration: underline;
            }

    .auth-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .auth-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }

    @@media (max-width: 620px) {
        .auth-card {
            flex-direction: column;
        }

        .auth-actions {
            padding-top: 0;
        }
    }

    /* ---------- Delete confirmation modal ---------- */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(42, 33, 28, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-box {
        background: var(--surface);
        border-radius: var(--radius-m);
        max-width: 420px;
        width: 100%;
        padding: 28px;
        box-shadow: 0 20px 60px -12px rgba(42, 33, 28, 0.45);
        border-top: 4px solid var(--oxblood);
        animation: modalPop 0.15s ease;
    }

    @@keyframes modalPop {
        from {
            transform: translateY(6px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    .modal-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f7e9e6;
        color: var(--oxblood);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .modal-icon svg {
            width: 22px;
            height: 22px;
        }

    .modal-box h3 {
        margin-bottom: 8px;
    }

    .modal-box p {
        color: var(--ink-soft);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .modal-box p strong {
            color: var(--ink);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-danger {
        background: var(--oxblood);
        color: var(--surface-warm);
        border-color: var(--oxblood);
    }

        .btn-danger:hover {
            background: var(--oxblood-dark);
        }
</style>

<div class="auth-page-head">
    <div>
        <h1 style="margin-bottom:4px;">Yazarlar</h1>
        <p>Kütüphane koleksiyonundaki kitapların yazarları.</p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("CreateAuthor", "Author")">Yeni yazar ekle</a>
</div>

<div class="auth-stats">
    <div class="auth-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam yazar</div>
    </div>
    <div class="auth-stat">
        <div class="num">@(Model != null && Model.Any() ? Model.OrderByDescending(y => y.ID).First().AD + " " + Model.OrderByDescending(y => y.ID).First().SOYAD : "-")</div>
        <div class="label">En son eklenen</div>
    </div>
</div>

<div class="auth-toolbar">
    <div class="auth-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="authSearchInput" placeholder="Yazar ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="auth-count" id="authCount">@Model.Count() yazar listeleniyor</p>

    <div class="auth-list" id="authList">
        @foreach (var yazar in Model)
        {
            var tamAd = yazar.AD + " " + yazar.SOYAD;
            var initials = (yazar.AD.Length > 0 ? yazar.AD.Substring(0, 1) : "") + (yazar.SOYAD.Length > 0 ? yazar.SOYAD.Substring(0, 1) : "");
            <div class="auth-card" data-name="@tamAd.ToLower()">
                <div class="auth-avatar">@initials.ToUpper()</div>
                <div class="auth-body">
                    <div class="auth-id">Yazar No: @yazar.ID</div>
                    <h3>@tamAd</h3>
                    @if (!string.IsNullOrWhiteSpace(yazar.DETAY))
                    {
                        <p class="auth-detay">@yazar.DETAY</p>
                    }
                    else
                    {
                        <p class="auth-detay">Bu yazar için henüz bir açıklama girilmemiş.</p>
                    }
                </div>
                <div class="auth-actions">
                    <a href="@Url.Action("UpdateAuthor", "Author", new { id = yazar.ID })">Düzenle</a>
                    <button type="button" class="danger" onclick="openDeleteModal('@yazar.ID', '@tamAd.Replace("'", "\\'")')">Sil</button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="panel auth-empty">
        <h3>Henüz yazar eklenmemiş</h3>
        <p>İlk yazarı ekleyerek kitaplarınızı yazarlarına göre listelemeye başlayın.</p>
        <a class="btn btn-primary" href="@Url.Action("CreateAuthor", "Author")" style="margin-top:12px;">Yeni yazar ekle</a>
    </div>
}

<!-- Silme onay modalı -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M10.3 3.86 2.7 18a1.5 1.5 0 0 0 1.3 2.25h16a1.5 1.5 0 0 0 1.3-2.25L13.7 3.86a1.5 1.5 0 0 0-2.6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Yazarı sil</h3>
        <p><strong id="deleteModalAuthorName"></strong> adlı yazarı silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>

        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Vazgeç</button>
            @using (Html.BeginForm("DeleteAuthor", "Author", FormMethod.Post, new { id = "deleteAuthorForm", style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteAuthorId" value="" />
                <button type="submit" class="btn btn-danger">Evet, sil</button>
            }
        </div>
    </div>
</div>

<script>(function () {
        var input = document.getElementById("authSearchInput");
        var list = document.getElementById("authList");
        var countLabel = document.getElementById("authCount");
        if (!input || !list) return;

        var cards = Array.prototype.slice.call(list.querySelectorAll(".auth-card"));

        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;

            cards.forEach(function (card) {
                var match = card.getAttribute("data-name").indexOf(term) !== -1;
                card.style.display = match ? "" : "none";
                if (match) visible++;
            });

            if (countLabel) {
                countLabel.textContent = visible + " yazar listeleniyor";
            }
        });
    })();

    var deleteModal = document.getElementById("deleteModal");

    function openDeleteModal(id, name) {
        document.getElementById("deleteAuthorId").value = id;
        document.getElementById("deleteModalAuthorName").textContent = name;
        deleteModal.classList.add("is-open");
    }

    function closeDeleteModal() {
        deleteModal.classList.remove("is-open");
    }

    deleteModal.addEventListener("click", function (e) {
        if (e.target === deleteModal) closeDeleteModal();
    });

    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeDeleteModal();
    });</script>
