@{
    ViewBag.Title = "İstatistikler";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .stat-grid-lg {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .stat-card-lg {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 22px;
        box-shadow: var(--shadow-card);
        display: flex;
        align-items: flex-start;
        gap: 16px;
    }

        .stat-card-lg.c-oxblood {
            border-left-color: var(--oxblood);
        }

        .stat-card-lg.c-forest {
            border-left-color: var(--forest);
        }

    .stat-icon-lg {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--surface-warm);
        color: var(--oxblood);
    }

        .stat-icon-lg svg {
            width: 20px;
            height: 20px;
        }

        .stat-icon-lg.forest {
            color: var(--forest);
        }

        .stat-icon-lg.brass {
            color: var(--brass);
        }

    .stat-card-lg .label {
        font-size: 0.78rem;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 6px;
    }

    .stat-card-lg .val {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--ink);
        line-height: 1.3;
        margin-bottom: 3px;
    }

    .stat-card-lg .sub {
        font-size: 0.84rem;
        color: var(--ink-soft);
    }

    @@media (max-width: 900px) {
        .stat-grid-lg {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 560px) {
        .stat-grid-lg {
            grid-template-columns: 1fr;
        }
    }
</style>

<h1 style="margin-bottom:4px;">İstatistikler</h1>
<p style="color:var(--ink-soft); margin-bottom:28px;">Koleksiyon ve kullanım verilerine dair öne çıkan bilgiler.</p>

<div class="stat-grid-lg">

    <div class="stat-card-lg">
        <div class="stat-icon-lg">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 20c1.5-4.5 4-9 8.5-13.5C14 5 16 4 18 4c0 2-1 4-2.5 5.5C11 14 6.5 16.5 4 20Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M12.5 9.5 15 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </div>
        <div>
            <div class="label">En çok kitabı olan yazar</div>
            <div class="val">@ViewBag.MostBookAuthorName</div>
            <div class="sub">@ViewBag.MostBookCount kitap</div>
        </div>
    </div>

    <div class="stat-card-lg c-forest">
        <div class="stat-icon-lg forest">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5" />
                <path d="M3 9h18" stroke="currentColor" stroke-width="1.5" />
            </svg>
        </div>
        <div>
            <div class="label">En çok kitap basan yayınevi</div>
            <div class="val">@ViewBag.MostBookPublishing</div>
            <div class="sub">@ViewBag.MostBookPublishingCount kitap</div>
        </div>
    </div>

    <div class="stat-card-lg">
        <div class="stat-icon-lg brass">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" />
                <rect x="13" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" />
                <rect x="4" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" />
                <rect x="13" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" />
            </svg>
        </div>
        <div>
            <div class="label">En popüler kategori</div>
            <div class="val">@ViewBag.CategoryName</div>
            <div class="sub">@ViewBag.BookCountMostCategory kitap</div>
        </div>
    </div>

    <div class="stat-card-lg c-forest">
        <div class="stat-icon-lg forest">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.5" />
                <path d="M5 20c1.2-4 4-6 7-6s5.8 2 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </div>
        <div>
            <div class="label">En aktif üye</div>
            <div class="val">@ViewBag.MostActiveMemberName</div>
            <div class="sub">@ViewBag.CountTransactions ödünç işlemi</div>
        </div>
    </div>

    <div class="stat-card-lg">
        <div class="stat-icon-lg">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5" />
                <circle cx="9" cy="11" r="2" stroke="currentColor" stroke-width="1.5" />
                <path d="M6 16c.6-1.5 1.8-2.3 3-2.3s2.4.8 3 2.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                <path d="M14 10h4M14 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </div>
        <div>
            <div class="label">En çok işlem yapan personel</div>
            <div class="val">@ViewBag.EmployeeName</div>
            <div class="sub">@ViewBag.Count işlem</div>
        </div>
    </div>

    <div class="stat-card-lg c-forest">
        <div class="stat-icon-lg forest">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5C4.7 20 4 19.3 4 18.5v-13Z" stroke="currentColor" stroke-width="1.5" />
                <path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5c.8 0 1.5-.7 1.5-1.5v-13Z" stroke="currentColor" stroke-width="1.5" />
            </svg>
        </div>
        <div>
            <div class="label">En çok ödünç alınan kitap</div>
            <div class="val">@ViewBag.LendBookName</div>
            <div class="sub">@ViewBag.LendBookCount kez ödünç verildi</div>
        </div>
    </div>

    <div class="stat-card-lg">
        <div class="stat-icon-lg">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 8v4l3 3M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" stroke="currentColor" stroke-width="1.5" />
            </svg>
        </div>
        <div>
            <div class="label">Ortalama ödünç süresi</div>
            <div class="val">@ViewBag.AverageLoanDays gün</div>
            <div class="sub">Son 30 gün ortalaması</div>
        </div>
    </div>

    <div class="stat-card-lg c-forest">
        <div class="stat-icon-lg forest">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div>
            <div class="label">Zamanında iade oranı</div>
            <div class="val">%@ViewBag.OnTimeReturnRate</div>
            <div class="sub">Son 30 gün</div>
        </div>
    </div>

    <div class="stat-card-lg">
        <div class="stat-icon-lg">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div>
            <div class="label">Toplam ceza geliri</div>
            <div class="val">@ViewBag.TotalPenaltySum TL</div>
            <div class="sub">Bu ay tahsil edilen</div>
        </div>
    </div>

</div>
