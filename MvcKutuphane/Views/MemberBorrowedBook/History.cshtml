@model List<MvcKutuphane.Models.Entities.TBL_HAREKET>

@{
    ViewBag.Title = "Geçmiş Ödünçlerim";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";

    var toplamKayit = Model != null ? Model.Count : 0;
    var gecikenSayisi = Model != null
        ? Model.Count(x => x.IADETARIH.HasValue && x.UYEGETIRDIGITARIH.HasValue && x.UYEGETIRDIGITARIH.Value > x.IADETARIH.Value)
        : 0;
}

<style>
    .history-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .history-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .history-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--brass);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .history-eyebrow-line {
        width: 28px;
        height: 1px;
        background: var(--brass);
    }

    .history-header h1 {
        margin: 0 0 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 2.15rem;
        line-height: 1.15;
    }

    .history-header p {
        margin: 0;
        max-width: 620px;
        color: var(--ink-soft);
        font-size: 0.94rem;
        line-height: 1.6;
    }

    .history-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .history-stat {
        min-width: 125px;
        padding: 13px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
    }

        .history-stat span {
            display: block;
            margin-bottom: 4px;
            color: var(--ink-soft);
            font-size: 0.67rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .history-stat strong {
            color: var(--forest);
            font-family: var(--font-display);
            font-size: 1.35rem;
            line-height: 1;
        }

        .history-stat.late strong {
            color: var(--oxblood);
        }

    .history-list {
        display: grid;
        gap: 14px;
    }

    .history-card {
        display: flex;
        align-items: center;
        gap: 18px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--forest);
        border-radius: var(--radius-m);
        padding: 18px 22px;
        box-shadow: var(--shadow-card);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

        .history-card.is-late {
            border-left-color: var(--oxblood);
        }

        .history-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(42, 33, 28, 0.09);
        }

    .history-spine {
        width: 42px;
        height: 58px;
        border-radius: 4px;
        background: var(--forest);
        flex-shrink: 0;
    }

    .history-card.is-late .history-spine {
        background: var(--oxblood);
    }

    .history-info {
        flex: 1;
        min-width: 0;
    }

        .history-info h3 {
            font-family: var(--font-display);
            font-size: 1.05rem;
            margin: 0 0 4px;
            color: var(--ink);
        }

    .history-dates {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 0.82rem;
        color: var(--ink-soft);
    }

        .history-dates span strong {
            color: var(--ink);
            font-weight: 600;
        }

    .history-status {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
    }

        .history-status svg {
            width: 13px;
            height: 13px;
        }

        .history-status.ontime {
            color: var(--forest);
            background: #eef3ec;
        }

        .history-status.late {
            color: var(--oxblood);
            background: #f7e9e6;
        }

    .history-empty {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 76px 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
    }

    .history-empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 19px;
        border-radius: 50%;
        background: #edf3ee;
        color: var(--forest);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .history-empty-icon svg {
            width: 31px;
            height: 31px;
        }

    .history-empty h3 {
        margin: 0 0 8px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.35rem;
    }

    .history-empty p {
        max-width: 420px;
        margin: 0 auto;
        color: var(--ink-soft);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    @@media (max-width: 700px) {
        .history-header h1 {
            font-size: 1.75rem;
        }

        .history-stats {
            width: 100%;
        }

        .history-stat {
            flex: 1;
            min-width: 0;
        }

        .history-card {
            flex-wrap: wrap;
        }

        .history-status {
            margin-left: 60px;
        }
    }
</style>

<div class="history-page">

    <div class="history-header">
        <div>
            <div class="history-eyebrow">
                <span class="history-eyebrow-line"></span>
                Hesabım
            </div>
            <h1>Geçmiş Ödünçlerim</h1>
            <p>Daha önce ödünç alıp iade ettiğiniz kitapların geçmişi.</p>
        </div>

        <div class="history-stats">
            <div class="history-stat">
                <span>Toplam</span>
                <strong>@toplamKayit</strong>
            </div>
            <div class="history-stat late">
                <span>Geç İade</span>
                <strong>@gecikenSayisi</strong>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="history-list">
            @foreach (var h in Model)
            {
                bool gecMi = h.IADETARIH.HasValue && h.UYEGETIRDIGITARIH.HasValue && h.UYEGETIRDIGITARIH.Value > h.IADETARIH.Value;
                var kitapAd = h.TBL_KITAP != null ? h.TBL_KITAP.AD : "-";

                <div class="history-card @(gecMi ? "is-late" : "")">
                    <div class="history-spine"></div>

                    <div class="history-info">
                        <h3>@kitapAd</h3>
                        <div class="history-dates">
                            <span>Alış: <strong>@(h.ALISTARIH.HasValue ? h.ALISTARIH.Value.ToString("dd.MM.yyyy") : "-")</strong></span>
                            <span>Teslim tarihi: <strong>@(h.IADETARIH.HasValue ? h.IADETARIH.Value.ToString("dd.MM.yyyy") : "-")</strong></span>
                            <span>İade: <strong>@(h.UYEGETIRDIGITARIH.HasValue ? h.UYEGETIRDIGITARIH.Value.ToString("dd.MM.yyyy") : "-")</strong></span>
                        </div>
                    </div>

                    @if (gecMi)
                    {
                        <span class="history-status late">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                            Geç iade
                        </span>
                    }
                    else
                    {
                        <span class="history-status ontime">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            Zamanında
                        </span>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="history-empty">
            <div class="history-empty-icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5C4.7 20 4 19.3 4 18.5v-13Z" stroke="currentColor" stroke-width="1.5" />
                    <path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5c.8 0 1.5-.7 1.5-1.5v-13Z" stroke="currentColor" stroke-width="1.5" />
                </svg>
            </div>
            <h3>Henüz geçmiş ödünç kaydınız yok</h3>
            <p>İlk kitabınızı ödünç alıp iade ettiğinizde, geçmişiniz burada görünecek.</p>
        </div>
    }

</div>
