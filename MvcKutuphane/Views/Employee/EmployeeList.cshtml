@model List<MvcKutuphane.Models.Entities.TBL_PERSONEL>
@using System.Web
@{
    ViewBag.Title = "Personel";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<style>
    .emp-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

        .emp-page-head p {
            color: var(--ink-soft);
            margin: 6px 0 0;
        }

    .emp-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }

    .emp-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        padding: 18px 20px;
        box-shadow: var(--shadow-card);
    }

        .emp-stat .num {
            font-family: var(--font-display);
            font-size: 1.9rem;
            font-weight: 600;
            color: var(--oxblood);
            line-height: 1;
            margin-bottom: 6px;
        }

        .emp-stat .label {
            font-size: 0.85rem;
            color: var(--ink-soft);
        }

    .emp-toolbar {
        display: flex;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .emp-search {
        flex: 1;
        min-width: 220px;
        position: relative;
    }

        .emp-search input {
            width: 100%;
            padding: 11px 14px 11px 38px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--ink);
        }

            .emp-search input:focus {
                outline: none;
                border-color: var(--oxblood);
            }

        .emp-search svg {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--ink-soft);
        }

    .emp-count {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .emp-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 18px;
    }

    .emp-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 20px;
        box-shadow: var(--shadow-card);
        transition: transform 0.15s ease, border-left-color 0.15s ease;
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .emp-card:hover {
            transform: translateY(-2px);
            border-left-color: var(--oxblood);
        }

    .emp-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--oxblood);
        color: var(--surface-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-weight: 600;
        flex-shrink: 0;
    }

    .emp-card .emp-id {
        font-size: 0.75rem;
        color: var(--ink-soft);
        letter-spacing: 0.03em;
        margin-bottom: 4px;
    }

    .emp-card h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .emp-card-actions {
        display: flex;
        gap: 14px;
        margin-left: auto;
    }

        .emp-card-actions a, .emp-card-actions button {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--forest);
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            font-family: var(--font-body);
            white-space: nowrap;
        }

            .emp-card-actions button.danger {
                color: var(--oxblood);
            }

            .emp-card-actions a:hover, .emp-card-actions button:hover {
                text-decoration: underline;
            }

    .emp-empty {
        text-align: center;
        padding: 60px 20px;
        color: var(--ink-soft);
    }

        .emp-empty h3 {
            color: var(--ink);
            margin-bottom: 8px;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(42, 33, 28, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 200;
        padding: 20px;
    }

        .modal-overlay.is-open {
            display: flex;
        }

    .modal-box {
        background: var(--surface);
        border-radius: var(--radius-m);
        max-width: 420px;
        width: 100%;
        padding: 28px;
        box-shadow: 0 20px 60px -12px rgba(42, 33, 28, 0.45);
        border-top: 4px solid var(--oxblood);
    }

    .modal-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: #f7e9e6;
        color: var(--oxblood);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .modal-icon svg {
            width: 22px;
            height: 22px;
        }

    .modal-box h3 {
        margin-bottom: 8px;
    }

    .modal-box p {
        color: var(--ink-soft);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

        .modal-box p strong {
            color: var(--ink);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }

    .btn-danger {
        background: var(--oxblood);
        color: var(--surface-warm);
        border-color: var(--oxblood);
    }

        .btn-danger:hover {
            background: var(--oxblood-dark);
        }
</style>

<div class="emp-page-head">
    <div>
        <h1 style="margin-bottom:4px;">Personel</h1>
        <p>Kütüphanede görev yapan personel listesi.</p>
    </div>
    <a class="btn btn-primary" href="@Url.Action("CreateEmployee", "Employee")">Yeni personel ekle</a>
</div>

<div class="emp-stats">
    <div class="emp-stat">
        <div class="num">@(Model != null ? Model.Count : 0)</div>
        <div class="label">Toplam personel</div>
    </div>
</div>

<div class="emp-toolbar">
    <div class="emp-search">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <input type="text" id="empSearchInput" placeholder="Personel ara..." autocomplete="off" />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <p class="emp-count" id="empCount">@Model.Count() personel listeleniyor</p>

    <div class="emp-grid" id="empGrid">
        @foreach (var p in Model)
        {
            count++;
            var initials = !string.IsNullOrWhiteSpace(p.PERSONEL) ? p.PERSONEL.Trim().Substring(0, 1).ToUpper() : "?";
            <div class="emp-card" data-name="@(p.PERSONEL ?? "").ToLower()">
                <div class="emp-avatar">@initials</div>
                <div>
                    <div class="emp-id">Personel No: @count</div>
                    <h3>@p.PERSONEL</h3>
                </div>
                <div class="emp-card-actions">
                    <a href="@Url.Action("UpdateEmployee", "Employee", new { id = p.ID })">Düzenle</a>
                    <button type="button" class="danger" onclick="openDeleteModal('@p.ID', '@Html.Raw(HttpUtility.JavaScriptStringEncode(p.PERSONEL ?? ""))')">Sil</button>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="panel emp-empty">
        <h3>Henüz personel eklenmemiş</h3>
        <p>İlk personeli ekleyerek başlayın.</p>
        <a class="btn btn-primary" href="@Url.Action("CreateEmployee", "Employee")" style="margin-top:12px;">Yeni personel ekle</a>
    </div>
}

<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M10.3 3.86 2.7 18a1.5 1.5 0 0 0 1.3 2.25h16a1.5 1.5 0 0 0 1.3-2.25L13.7 3.86a1.5 1.5 0 0 0-2.6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </svg>
        </div>
        <h3>Personeli sil</h3>
        <p><strong id="deleteModalEmpName"></strong> adlı personeli silmek istediğinize emin misiniz? Bu işlem geri alınamaz.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-ghost" onclick="closeDeleteModal()">Vazgeç</button>
            @using (Html.BeginForm("DeleteEmployee", "Employee", FormMethod.Post, new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteEmpId" value="" />
                <button type="submit" class="btn btn-danger">Evet, sil</button>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById("empSearchInput");
        var grid = document.getElementById("empGrid");
        var countLabel = document.getElementById("empCount");
        if (!input || !grid) return;
        var cards = Array.prototype.slice.call(grid.querySelectorAll(".emp-card"));
        input.addEventListener("input", function () {
            var term = input.value.trim().toLowerCase();
            var visible = 0;
            cards.forEach(function (card) {
                var match = card.getAttribute("data-name").indexOf(term) !== -1;
                card.style.display = match ? "" : "none";
                if (match) visible++;
            });
            if (countLabel) countLabel.textContent = visible + " personel listeleniyor";
        });
    })();

    var deleteModal = document.getElementById("deleteModal");
    function openDeleteModal(id, name) {
        document.getElementById("deleteEmpId").value = id;
        document.getElementById("deleteModalEmpName").textContent = name;
        deleteModal.classList.add("is-open");
    }
    function closeDeleteModal() { deleteModal.classList.remove("is-open"); }
    deleteModal.addEventListener("click", function (e) { if (e.target === deleteModal) closeDeleteModal(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDeleteModal(); });
</script>