@model MvcKutuphane.Models.Entities.TBL_KITAP
@{
    ViewBag.Title = Model.AD;
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .detail-wrap {
        max-width: 1000px;
        margin: 0 auto;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 28px;
    }

        .back-link svg {
            width: 16px;
            height: 16px;
        }

    .book-detail-grid {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        margin-bottom: 56px;
    }

    .book-cover {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        border-radius: var(--radius-m);
        overflow: hidden;
        box-shadow: var(--shadow-lift);
        background: #2a211c;
        display: flex;
        align-items: flex-end;
    }

        .book-cover img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .book-cover-label {
        position: relative;
        z-index: 1;
        padding: 20px;
        color: var(--surface-warm);
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.05rem;
        line-height: 1.3;
    }

    .book-cover.has-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.75) 100%);
    }

    .book-info-side .tag {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--forest);
        background: #eef3ec;
        border-radius: 999px;
        padding: 4px 14px;
        margin-bottom: 14px;
    }

    .book-info-side h1 {
        margin-bottom: 6px;
    }

    .book-author {
        font-size: 1.1rem;
        color: var(--ink-soft);
        margin-bottom: 24px;
    }

        .book-author a {
            font-weight: 600;
        }

    .book-status-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 28px;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 6px 16px;
        border-radius: 999px;
    }

        .badge-status svg {
            width: 14px;
            height: 14px;
        }

    .badge-available {
        color: var(--forest);
        background: #eef3ec;
    }

    .badge-loaned {
        color: var(--oxblood);
        background: #f7e9e6;
    }

    .meta-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 32px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
    }

    .meta-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--surface-warm);
        color: var(--brass);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .meta-icon svg {
            width: 17px;
            height: 17px;
        }

    .meta-item .label {
        font-size: 0.76rem;
        color: var(--ink-soft);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .meta-item .value {
        font-family: var(--font-display);
        font-weight: 600;
        color: var(--ink);
        font-size: 0.98rem;
    }

    .book-detail-actions {
        display: flex;
        gap: 14px;
    }

    .author-bio-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 28px;
        margin-bottom: 56px;
    }

        .author-bio-panel h3 {
            font-size: 1.15rem;
            margin-bottom: 12px;
        }

        .author-bio-panel p {
            color: var(--ink-soft);
            margin: 0;
            line-height: 1.7;
        }

    @@media (max-width: 700px) {
        .book-detail-grid {
            grid-template-columns: 1fr;
        }

        .book-cover {
            max-width: 220px;
            margin: 0 auto;
        }

        .meta-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="detail-wrap">

    <a href="@Url.Action("BookList", "Catalog")" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Kataloğa geri dön
    </a>

    @{
        bool hasImage = !string.IsNullOrEmpty(Model.FOTOGRAF);
        var yazarAdi = Model.TBL_YAZAR != null ? Model.TBL_YAZAR.AD + " " + Model.TBL_YAZAR.SOYAD : "Bilinmeyen Yazar";
        var kategoriAdi = Model.TBL_KATEGORI != null ? Model.TBL_KATEGORI.CategoryName : "Diğer";
    }

    <div class="book-detail-grid">
        <div>
            <div class="book-cover @(hasImage ? "has-image" : "")" style="@(hasImage ? "" : "background:#7a2a2e;")">
                @if (hasImage)
                {
                    <img src="@Model.FOTOGRAF" alt="@Model.AD" onerror="this.style.display='none';" />
                }
                <div class="book-cover-label">@Model.AD</div>
            </div>
        </div>

        <div class="book-info-side">
            <span class="tag">@kategoriAdi</span>
            <h1>@Model.AD</h1>
            <p class="book-author">
                @if (Model.TBL_YAZAR != null)
                {
                    <a href="@Url.Action("AuthorBooks", "Catalog", new { id = Model.TBL_YAZAR.ID })">@yazarAdi</a>
                }
                else
                {
                    @yazarAdi
                }
            </p>

            <div class="book-status-row">
                @if (Model.DURUM == true)
                {
                    <span class="badge-status badge-available">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        Rafta mevcut
                    </span>
                }
                else
                {
                    <span class="badge-status badge-loaned">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                        Şu anda ödünçte
                    </span>
                }
            </div>

            <div class="meta-grid">
                <div class="meta-item">
                    <div class="meta-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3.5" y="5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M7 3.5v3M17 3.5v3M3.5 9h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    </div>
                    <div>
                        <div class="label">Basım Yılı</div>
                        <div class="value">@Model.BASIMYIL</div>
                    </div>
                </div>

                <div class="meta-item">
                    <div class="meta-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5" /><path d="M3 9h18" stroke="currentColor" stroke-width="1.5" /></svg>
                    </div>
                    <div>
                        <div class="label">Yayınevi</div>
                        <div class="value">@Model.YAYINEVI</div>
                    </div>
                </div>

                <div class="meta-item">
                    <div class="meta-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5C4.7 20 4 19.3 4 18.5v-13Z" stroke="currentColor" stroke-width="1.5" /><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5c.8 0 1.5-.7 1.5-1.5v-13Z" stroke="currentColor" stroke-width="1.5" /></svg>
                    </div>
                    <div>
                        <div class="label">Sayfa Sayısı</div>
                        <div class="value">@Model.SAYFA</div>
                    </div>
                </div>

                <div class="meta-item">
                    <div class="meta-icon">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="13" y="4" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="4" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="13" y="13" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5" /></svg>
                    </div>
                    <div>
                        <div class="label">Kategori</div>
                        <div class="value">@kategoriAdi</div>
                    </div>
                </div>
            </div>

            <div class="book-detail-actions">
                @if (Request.IsAuthenticated)
                {
                    <a class="btn btn-primary" href="@Url.Action("Index", "MemberBorrowedBook")">Ödünç almak için üyeliğimi kullan</a>
                }
                else
                {
                    <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Ödünç almak için giriş yapın</a>
                }
                <a class="btn btn-ghost" href="@Url.Action("BookListWithCategory", "Catalog", new {id=Model.KATEGORI})">Kategorideki diğer kitaplar</a>
            </div>
        </div>
    </div>

    @if (ViewBag.KitapDetay != null)
    {
        <div class="panel" style="margin-bottom: 32px;">
            <h3 style="font-size: 1.15rem; margin-bottom: 12px;">Kitap Hakkında</h3>
            <p style="color: var(--ink-soft); margin: 0; line-height: 1.7; white-space: pre-line;">@ViewBag.KitapDetay</p>
        </div>
    }

    @if (Model.TBL_YAZAR != null && !string.IsNullOrWhiteSpace(Model.TBL_YAZAR.DETAY))
    {
        <div class="author-bio-panel">
            <h3>Yazar hakkında</h3>
            <p>@Model.TBL_YAZAR.DETAY</p>
        </div>
    }

</div>
