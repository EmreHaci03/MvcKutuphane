@model List<MvcKutuphane.Models.Entities.TBL_DUYURU>

@{
    ViewBag.Title = "Duyurular";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";
}

<style>
    .announcement-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    /* ---------- Header ---------- */

    .announcement-page-head {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
        flex-wrap: wrap;
    }

        .announcement-page-head h1 {
            margin: 0 0 6px;
            font-family: var(--font-display);
            font-size: 2rem;
            color: var(--ink);
        }

        .announcement-page-head p {
            margin: 0;
            color: var(--ink-soft);
            font-size: 0.95rem;
        }

    .announcement-total {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
        padding: 10px 15px;
        color: var(--ink-soft);
        font-size: 0.85rem;
        box-shadow: var(--shadow-card);
    }

        .announcement-total strong {
            color: var(--oxblood);
            font-family: var(--font-display);
            font-size: 1rem;
        }

    /* ---------- List ---------- */

    .announcement-list {
        display: grid;
        gap: 18px;
    }

    .announcement-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-left: 4px solid var(--brass);
        border-radius: var(--radius-m);
        padding: 22px 24px 20px;
        box-shadow: var(--shadow-card);
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-left-color 0.15s ease;
    }

        .announcement-card:hover {
            transform: translateY(-2px);
            border-left-color: var(--oxblood);
            box-shadow: 0 10px 28px rgba(42, 33, 28, 0.08);
        }

    /* ---------- Card Top ---------- */

    .announcement-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 13px;
        flex-wrap: wrap;
    }

    .announcement-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--oxblood);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

        .announcement-label svg {
            width: 15px;
            height: 15px;
        }

    .announcement-date {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--ink-soft);
        font-size: 0.8rem;
    }

        .announcement-date svg {
            width: 14px;
            height: 14px;
        }

    /* ---------- Content ---------- */

    .announcement-title {
        margin: 0 0 10px;
        font-family: var(--font-display);
        font-size: 1.35rem;
        line-height: 1.3;
        color: var(--ink);
    }

    .announcement-content {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
        line-height: 1.7;
        white-space: pre-line;
    }

    /* ---------- Footer ---------- */

    .announcement-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        color: var(--ink-soft);
        font-size: 0.78rem;
    }

        .announcement-footer svg {
            width: 14px;
            height: 14px;
            color: var(--brass);
        }

    /* ---------- Empty ---------- */

    .announcement-empty {
        text-align: center;
        padding: 70px 20px;
        color: var(--ink-soft);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
    }

    .announcement-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f7eee5;
        color: var(--brass);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .announcement-empty-icon svg {
            width: 28px;
            height: 28px;
        }

    .announcement-empty h3 {
        margin: 0 0 8px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.25rem;
    }

    .announcement-empty p {
        margin: 0;
        font-size: 0.9rem;
    }

    /* ---------- Responsive ---------- */

    @@media (max-width: 700px) {

        .announcement-page-head {
            align-items: flex-start;
        }

            .announcement-page-head h1 {
                font-size: 1.7rem;
            }

        .announcement-card {
            padding: 19px;
        }

        .announcement-title {
            font-size: 1.18rem;
        }

        .announcement-content {
            font-size: 0.9rem;
        }

        .announcement-meta {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }
    }
</style>

<div class="announcement-page">

    <!-- Sayfa başlığı -->
    <div class="announcement-page-head">

        <div>
            <h1>Duyurular</h1>
            <p>Kütüphaneden yapılan güncel duyurular ve bilgilendirmeler.</p>
        </div>

        <div class="announcement-total">
            <strong>@(Model != null ? Model.Count : 0)</strong>
            duyuru
        </div>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="announcement-list">

            @foreach (var duyuru in Model.OrderByDescending(x => x.YAYINTARIHI))
            {
                <article class="announcement-card">

                    <div class="announcement-meta">

                        <div class="announcement-label">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">

                                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v9a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h-.5A2.5 2.5 0 0 1 3.5 14V6"
                                      stroke="currentColor"
                                      stroke-width="1.6"
                                      stroke-linejoin="round" />

                            </svg>

                            Duyuru
                        </div>

                        <div class="announcement-date">

                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 xmlns="http://www.w3.org/2000/svg">

                                <rect x="3.5"
                                      y="5"
                                      width="17"
                                      height="15"
                                      rx="2"
                                      stroke="currentColor"
                                      stroke-width="1.5" />

                                <path d="M7 3.5v3M17 3.5v3M3.5 9h17"
                                      stroke="currentColor"
                                      stroke-width="1.5"
                                      stroke-linecap="round" />

                            </svg>

                            @if (duyuru.YAYINTARIHI.HasValue)
                            {
                                @duyuru.YAYINTARIHI.Value.ToString("dd.MM.yyyy HH:mm")
                            }
                            else
                            {
                                @:Tarih belirtilmemiş
                            }

                        </div>

                    </div>

                    <h2 class="announcement-title">
                        @duyuru.BASLIK
                    </h2>

                    <p class="announcement-content">
                        @duyuru.ICERIK
                    </p>

                    <div class="announcement-footer">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">

                            <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"
                                  stroke="currentColor"
                                  stroke-width="1.5" />

                            <path d="M12 7v5l3 2"
                                  stroke="currentColor"
                                  stroke-width="1.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />

                        </svg>

                        Kütüphane yönetimi tarafından yayınlandı

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <div class="announcement-empty">

            <div class="announcement-empty-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v9a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h-.5A2.5 2.5 0 0 1 3.5 14V6"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linejoin="round" />

                    <path d="M8 9h8M8 13h5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round" />

                </svg>

            </div>

            <h3>Henüz duyuru bulunmuyor</h3>

            <p>
                Kütüphane tarafından yayınlanan duyurular burada görünecek.
            </p>

        </div>
    }

</div>


Bu versiyonda admin sayfasındaki renkler, border, kart yapısı ve tipografi korunuyor, ama üye tarafında daha sade bir görünüm var. Ayrıca YAYINTARIHI yine DateTime? olarak güvenli şekilde işleniyor.