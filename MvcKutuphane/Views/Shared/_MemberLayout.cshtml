@{ 
    string memberName = "Üyem";
    string memberInitial = "Ü";
    string Mail = Session["Mail"] as string;
    if (!string.IsNullOrEmpty(Mail))
    {
        using(var db =new MvcKutuphane.Models.Entities.DbKutuphaneEntities2())
        {
            var Member = db.TBL_UYELER.FirstOrDefault(x => x.MAIL == Mail);
            if (Member != null)
            {
                memberName = Member.AD + " " + Member.SOYAD;
                memberInitial = (!string.IsNullOrWhiteSpace(Member.AD) && !string.IsNullOrWhiteSpace(Member.SOYAD))
                    ? Member.AD.Substring(0, 1).ToUpper() + Member.SOYAD.Substring(0, 1).ToUpper()
                    : "Ü";
            }
        }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Üyelik Panelim</title>

    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
        .sidebar-nav-toggle {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 10px 12px;
            border-radius: var(--radius-s);
            color: #ead9c8;
            font-size: 0.94rem;
            font-weight: 500;
            background: none;
            border: none;
            cursor: pointer;
            font-family: var(--font-body);
            margin-bottom: 2px;
        }

            .sidebar-nav-toggle svg:first-child {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                opacity: 0.85;
            }

            .sidebar-nav-toggle span {
                flex: 1;
                text-align: left;
            }

            .sidebar-nav-toggle .chevron {
                width: 14px;
                height: 14px;
                flex-shrink: 0;
                transition: transform 0.2s ease;
            }

            .sidebar-nav-toggle:hover {
                background: rgba(255,255,255,0.06);
                color: #ffffff;
            }

            .sidebar-nav-toggle.active {
                color: #ffffff;
            }

            .sidebar-nav-toggle.open .chevron {
                transform: rotate(180deg);
            }

        .sidebar-submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.2s ease;
            padding-left: 30px;
        }

            .sidebar-submenu.is-open {
                max-height: 200px;
            }

            .sidebar-submenu a {
                display: block;
                padding: 8px 12px;
                font-size: 0.88rem;
                color: #d9c4b0;
                border-radius: var(--radius-s);
                margin-bottom: 2px;
            }

                .sidebar-submenu a:hover {
                    background: rgba(255,255,255,0.06);
                    color: #ffffff;
                }

                .sidebar-submenu a.active {
                    color: var(--brass-light);
                    font-weight: 600;
                }
        :root {
            --bg: #f7f3ea;
            --surface: #ffffff;
            --surface-warm: #fbf7ef;
            --ink: #2a211c;
            --ink-soft: #6b5d52;
            --border: #e3d9c2;
            --border-strong: #d8c9a8;
            --oxblood: #7a2a2e;
            --oxblood-dark: #5b1f22;
            --forest: #2f4a3e;
            --brass: #a9793b;
            --brass-light: #cfa768;
            --radius-s: 3px;
            --radius-m: 6px;
            --radius-l: 10px;
            --font-display: "Lora", Georgia, "Times New Roman", serif;
            --font-body: "Source Sans 3", "Segoe UI", Arial, sans-serif;
            --shadow-card: 0 1px 2px rgba(42, 33, 28, 0.06), 0 8px 24px -12px rgba(42, 33, 28, 0.18);
            --sidebar-w: 240px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font-body);
            font-size: 16px;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: var(--oxblood);
            text-decoration: none;
        }

        h1, h2, h3, h4 {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink);
            margin: 0 0 0.5em;
        }

        h1 {
            font-size: 2rem;
            line-height: 1.2;
        }

        h2 {
            font-size: 1.5rem;
        }

        h3 {
            font-size: 1.2rem;
        }

        p {
            margin: 0 0 1em;
        }

        /* ---------- Shell ---------- */
        .member-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Sidebar ---------- */
        .member-sidebar {
            width: var(--sidebar-w);
            flex-shrink: 0;
            background: var(--oxblood-dark);
            color: #ecdfd2;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 22px 22px 18px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .sidebar-brand svg {
                width: 26px;
                height: 26px;
                color: var(--brass-light);
                flex-shrink: 0;
            }

            .sidebar-brand span {
                font-family: var(--font-display);
                font-weight: 600;
                font-size: 1.1rem;
                color: #f4ead9;
            }

        .sidebar-member {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 22px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: var(--brass);
            color: #2a1a0e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .sidebar-member .name {
            font-size: 0.92rem;
            font-weight: 600;
            color: #f4ead9;
            line-height: 1.3;
        }

        .sidebar-member .role {
            font-size: 0.76rem;
            color: #c8b7a4;
        }

        .sidebar-nav {
            flex: 1;
            padding: 16px 12px;
            overflow-y: auto;
        }

        .sidebar-section-label {
            font-size: 0.72rem;
            color: #b89b83;
            padding: 10px 12px 6px;
            letter-spacing: 0.02em;
        }

        .sidebar-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: var(--radius-s);
            color: #ead9c8;
            font-size: 0.94rem;
            font-weight: 500;
            margin-bottom: 2px;
        }

            .sidebar-nav a svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                opacity: 0.85;
            }

            .sidebar-nav a:hover {
                background: rgba(255,255,255,0.06);
                color: #ffffff;
            }

            .sidebar-nav a.active {
                background: var(--brass);
                color: #2a1a0e;
                font-weight: 600;
            }

                .sidebar-nav a.active svg {
                    opacity: 1;
                }

        .sidebar-foot {
            padding: 14px 12px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-logout {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: var(--radius-s);
            color: #ead9c8;
            font-size: 0.9rem;
            font-weight: 500;
            width: 100%;
            background: none;
            border: none;
        }

            .sidebar-logout svg {
                width: 17px;
                height: 17px;
                flex-shrink: 0;
            }

            .sidebar-logout:hover {
                background: rgba(255,255,255,0.06);
                color: #ffffff;
            }

        /* ---------- Main area ---------- */
        .member-main {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .member-topbar {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .member-topbar .crumb {
                font-size: 0.85rem;
                color: var(--ink-soft);
            }

                .member-topbar .crumb strong {
                    color: var(--ink);
                    font-weight: 600;
                }

        .sidebar-toggle {
            display: none;
            background: none;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            padding: 7px 10px;
            cursor: pointer;
        }

        .member-content {
            padding: 32px;
            flex: 1;
        }

        /* ---------- Shared content patterns ---------- */
        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-m);
            padding: 28px;
            box-shadow: var(--shadow-card);
        }

            .panel + .panel {
                margin-top: 20px;
            }

        .flash {
            padding: 12px 16px;
            border-radius: var(--radius-s);
            margin-bottom: 24px;
            font-size: 0.95rem;
            border: 1px solid transparent;
        }

        .flash-ok {
            background: #eef3ec;
            border-color: #cfe0c9;
            color: var(--forest);
        }

        .flash-error {
            background: #f7e9e6;
            border-color: #e6c3ba;
            color: var(--oxblood-dark);
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: var(--radius-s);
            font-size: 0.92rem;
            font-weight: 600;
            border: 1px solid transparent;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--oxblood);
            color: var(--surface-warm);
            border-color: var(--oxblood);
        }

            .btn-primary:hover {
                background: var(--oxblood-dark);
            }

        .btn-ghost {
            background: transparent;
            color: var(--ink);
            border-color: var(--border-strong);
        }

            .btn-ghost:hover {
                border-color: var(--oxblood);
                color: var(--oxblood);
            }

        table.data-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
        }

            table.data-table th, table.data-table td {
                text-align: left;
                padding: 12px 14px;
                border-bottom: 1px solid var(--border);
                font-size: 0.92rem;
            }

            table.data-table th {
                font-family: var(--font-display);
                font-weight: 600;
                color: var(--ink-soft);
                background: var(--surface-warm);
            }

        a:focus-visible, button:focus-visible {
            outline: 2px solid var(--brass);
            outline-offset: 2px;
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 900px) {
            .member-sidebar {
                position: fixed;
                left: -260px;
                z-index: 100;
                transition: left 0.2s ease;
            }

                .member-sidebar.is-open {
                    left: 0;
                    box-shadow: 0 0 40px rgba(0,0,0,0.35);
                }

            .member-content {
                padding: 22px 18px;
            }

            .member-topbar {
                padding: 14px 18px;
            }

            .sidebar-toggle {
                display: inline-flex;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>

    <div class="member-shell">

        <aside class="member-sidebar" id="memberSidebar">
            <div class="sidebar-brand">
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4 8c5-3 11-3 16 0v24c-5-3-11-3-16 0V8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M36 8c-5-3-11-3-16 0v24c5-3 11-3 16 0V8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M20 8v24" stroke="currentColor" stroke-width="1.2" />
                </svg>
                <span>Kütüphanem</span>
            </div>

            <div class="sidebar-member">
                <div class="sidebar-avatar">@(ViewBag.MemberInitial ?? "Ü")</div>
                <div>
                    <div class="name">@(ViewBag.MemberName ?? "Üyem")</div>
                    <div class="role">Üye</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="sidebar-section-label">Genel</div>
                <a href="@Url.Action("Index", "MemberDashboard")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberDashboard" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="7" height="9" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="14" y="3" width="7" height="5" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="14" y="12" width="7" height="9" rx="1" stroke="currentColor" stroke-width="1.5" /><rect x="3" y="16" width="7" height="5" rx="1" stroke="currentColor" stroke-width="1.5" /></svg>
                    Panelim
                </a>

                <div class="sidebar-section-label">Kitaplarım</div>
                <div class="sidebar-group">
                    <button type="button" class="sidebar-nav-toggle @(ViewContext.RouteData.Values["controller"].ToString() == "MemberBorrowedBook" ? "active open" : "")" onclick="toggleSubmenu(this)">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H12v16H5.5C4.7 20 4 19.3 4 18.5v-13Z" stroke="currentColor" stroke-width="1.5" /><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H12v16h6.5c.8 0 1.5-.7 1.5-1.5v-13Z" stroke="currentColor" stroke-width="1.5" /></svg>
                        <span>Ödünç Kitaplarım</span>
                        <svg class="chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>

                    <div class="sidebar-submenu @(ViewContext.RouteData.Values["controller"].ToString() == "MemberBorrowedBook" ? "is-open" : "")">
                        <a href="@Url.Action("ActiveLend", "MemberBorrowedBook")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberBorrowedBook" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">Aktif Ödünçlerim</a>
                        <a href="@Url.Action("History", "MemberBorrowedBook")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberBorrowedBook" && ViewContext.RouteData.Values["action"].ToString() == "History" ? "active" : "")">Geçmiş Ödünçlerim</a>
                    </div>
                </div>
                <div class="sidebar-group">
                    <button type="button" class="sidebar-nav-toggle @(ViewContext.RouteData.Values["controller"].ToString() == "MemberMyPenalties" ? "active open" : "")" onclick="toggleSubmenu(this)">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 8v4l3 3M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" stroke="currentColor" stroke-width="1.5" /></svg>
                        <span>Cezalarım</span>
                        <svg class="chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>

                    <div class="sidebar-submenu @(ViewContext.RouteData.Values["controller"].ToString() == "MemberMyPenalties" ? "is-open" : "")">
                        <a href="@Url.Action("Index", "MemberMyPenalties")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberMyPenalties" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">Ödenmemiş Cezalarım</a>
                        <a href="@Url.Action("MyOldPenalties", "MemberMyPenalties")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberMyPenalties" && ViewContext.RouteData.Values["action"].ToString() == "Paid" ? "active" : "")">Ödenen Cezalarım</a>
                    </div>
                </div>

                <div class="sidebar-section-label">Hesap</div>
                <a href="@Url.Action("Index", "MemberProfile")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "Profile" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.5" /><path d="M5 20c1.2-4 4-6 7-6s5.8 2 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                    Profilim
                </a>

                <a href="@Url.Action("Index", "MemberMessage")"
                   class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberMessages" ? "active" : "")">

                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v9a2.5 2.5 0 0 1-2.5 2.5H11l-4.5 4v-4h-.5A2.5 2.5 0 0 1 3.5 14V6"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linejoin="round" />
                        <path d="M8 9h8M8 13h5"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round" />
                    </svg>

                    Mesajlarım
                </a>

                <a href="@Url.Action("Index", "AI")"
                   class="@(ViewContext.RouteData.Values["controller"].ToString() == "AI" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3a7 7 0 0 0-7 7c0 2.1.93 3.98 2.4 5.27L7 20l5-2 5 2-.4-4.73A6.97 6.97 0 0 0 19 10a7 7 0 0 0-7-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <path d="M9 10h6M9 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    AI Kitap Önerisi
                </a>

                <a href="@Url.Action("Index", "MemberAnnouncement")" class="@(ViewContext.RouteData.Values["controller"].ToString() == "MemberAnnouncement" ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4 10h4l8-4v12l-8-4H4v-4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                        <path d="M8 14l2 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                    Duyurular
                </a>

                <a href="@Url.Action("Index", "Default")"
                   class="@(ViewContext.RouteData.Values["controller"].ToString() == "Default" ? "active" : "")">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg"
                         aria-hidden="true">

                        <!-- Açık kitap -->
                        <path d="M3.5 5.5C6.4 4.2 9.3 4.5 12 6v14c-2.7-1.5-5.6-1.8-8.5-.5v-14Z"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linejoin="round" />

                        <path d="M20.5 5.5C17.6 4.2 14.7 4.5 12 6v14c2.7-1.5 5.6-1.8 8.5-.5v-14Z"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linejoin="round" />

                        <path d="M12 6v14"
                              stroke="currentColor"
                              stroke-width="1.5" />

                        <!-- Vitrin yıldızı -->
                        <path d="M19 3.5l.55 1.55L21 5.5l-1.45.45L19 7.5l-.55-1.55L17 5.5l1.45-.45L19 3.5Z"
                              fill="currentColor" />
                    </svg>

                    Kitap Vitrini
                </a>


            </nav>

            <div class="sidebar-foot">
                <a class="sidebar-logout" href="@Url.Action("LogOut", "Account")">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M16 17l5-5-5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 12H9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                    Çıkış yap
                </a>
            </div>
        </aside>

        <div class="member-main">
            <header class="member-topbar">
                <div style="display:flex; align-items:center; gap:14px;">
                    <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Menüyü aç">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                    </button>
                    <div class="crumb">Üyelik Panelim / <strong>@ViewBag.Title</strong></div>
                </div>
            </header>

            <div class="member-content">
                @if (TempData["Message"] != null)
                {
                    <div class="flash flash-ok">@TempData["Message"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="flash flash-error">@TempData["Error"]</div>
                }

                @RenderBody()
            </div>
        </div>

    </div>

    <script>
        (function () {
            var toggle = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("memberSidebar");
            if (!toggle || !sidebar) return;
            toggle.addEventListener("click", function () {
                sidebar.classList.toggle("is-open");
            });
        })();
    </script>
    <script>
        (function () {
            var toggle = document.getElementById("sidebarToggle");
            var sidebar = document.getElementById("memberSidebar");
            if (!toggle || !sidebar) return;
            toggle.addEventListener("click", function () {
                sidebar.classList.toggle("is-open");
            });
        })();

        function toggleSubmenu(btn) {
            btn.classList.toggle("open");
            var submenu = btn.nextElementSibling;
            submenu.classList.toggle("is-open");
        }
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
