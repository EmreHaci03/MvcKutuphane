
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Kütüphanem</title>

    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg: #f7f3ea;
            --surface: #ffffff;
            --surface-warm: #fbf7ef;
            --ink: #2a211c;
            --ink-soft: #6b5d52;
            --border: #e3d9c2;
            --border-strong: #d8c9a8;
            --oxblood: #7a2a2e;
            --oxblood-dark: #5b1f22;
            --forest: #2f4a3e;
            --brass: #a9793b;
            --brass-light: #cfa768;
            --radius-s: 3px;
            --radius-m: 6px;
            --radius-l: 10px;
            --font-display: "Lora", Georgia, "Times New Roman", serif;
            --font-body: "Source Sans 3", "Segoe UI", Arial, sans-serif;
            --shadow-card: 0 1px 2px rgba(42, 33, 28, 0.06), 0 8px 24px -12px rgba(42, 33, 28, 0.18);
            --shadow-lift: 0 20px 50px -20px rgba(42, 33, 28, 0.35);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: var(--font-body);
            font-size: 16px;
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
        }

        .wrap {
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 28px;
        }

        a {
            color: var(--oxblood);
            text-decoration: none;
        }

        h1, h2, h3, h4 {
            font-family: var(--font-display);
            font-weight: 600;
            color: var(--ink);
            margin: 0 0 0.5em;
            letter-spacing: 0.005em;
        }

        h1 {
            font-size: 2.9rem;
            line-height: 1.12;
        }

        h2 {
            font-size: 2rem;
            line-height: 1.25;
        }

        h3 {
            font-size: 1.4rem;
            line-height: 1.3;
        }

        p {
            margin: 0 0 1em;
        }

        .eyebrow {
            font-family: var(--font-display);
            font-style: italic;
            color: var(--brass);
            font-size: 1rem;
            margin: 0 0 10px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .eyebrow::before {
                content: "";
                width: 26px;
                height: 1px;
                background: var(--brass);
                display: inline-block;
            }

        /* ---------- Top notice bar ---------- */
        .top-bar {
            background: var(--oxblood-dark);
            color: #ecdfd2;
            font-size: 0.82rem;
            text-align: center;
            padding: 7px 16px;
        }

        /* ---------- Header ---------- */
        .site-header {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(6px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .header-row {
            display: flex;
            align-items: center;
            gap: 28px;
            padding-top: 16px;
            padding-bottom: 16px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            color: var(--ink);
            flex-shrink: 0;
        }

        .brand-mark {
            width: 32px;
            height: 32px;
            color: var(--oxblood);
            flex-shrink: 0;
        }

        .brand-text {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 1.35rem;
            color: var(--ink);
        }

        .brand-text--light {
            color: var(--surface-warm);
        }

        .primary-nav {
            display: flex;
            gap: 32px;
            margin-left: 16px;
            flex: 1;
        }

            .primary-nav a {
                position: relative;
                color: var(--ink-soft);
                font-size: 0.98rem;
                font-weight: 500;
                padding: 6px 0;
            }

                .primary-nav a::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: -2px;
                    height: 2px;
                    background: var(--brass);
                    transform: scaleX(0);
                    transform-origin: left;
                    transition: transform 0.2s ease;
                }

                .primary-nav a:hover {
                    color: var(--oxblood);
                }

                    .primary-nav a:hover::after,
                    .primary-nav a.current::after {
                        transform: scaleX(1);
                    }

                .primary-nav a.current {
                    color: var(--oxblood);
                }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
            align-items: center;
        }

        .search-trigger {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 1px solid var(--border-strong);
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: var(--ink-soft);
        }

            .search-trigger:hover {
                border-color: var(--oxblood);
                color: var(--oxblood);
            }

            .search-trigger svg {
                width: 16px;
                height: 16px;
            }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 10px 20px;
            border-radius: var(--radius-s);
            font-size: 0.92rem;
            font-weight: 600;
            border: 1px solid transparent;
            cursor: pointer;
            transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
        }

        .btn-primary {
            background: var(--oxblood);
            color: var(--surface-warm);
            border-color: var(--oxblood);
        }

            .btn-primary:hover {
                background: var(--oxblood-dark);
            }

        .btn-ghost {
            background: transparent;
            color: var(--ink);
            border-color: var(--border-strong);
        }

            .btn-ghost:hover {
                border-color: var(--oxblood);
                color: var(--oxblood);
            }

        .nav-toggle {
            display: none;
            flex-direction: column;
            gap: 4px;
            background: none;
            border: 0;
            padding: 8px;
            cursor: pointer;
        }

            .nav-toggle span {
                width: 22px;
                height: 2px;
                background: var(--ink);
                display: block;
            }

        /* ---------- Hero ---------- */
        .hero {
            position: relative;
            overflow: hidden;
            background: radial-gradient(ellipse 700px 420px at 82% -10%, rgba(169, 121, 59, 0.16), transparent 60%), radial-gradient(ellipse 600px 400px at 5% 110%, rgba(122, 42, 46, 0.10), transparent 60%), var(--surface-warm);
            border-bottom: 1px solid var(--border);
        }

        .hero-inner {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 48px;
            align-items: center;
            padding: 76px 0 70px;
        }

        .hero h1 {
            margin-bottom: 20px;
        }

        .hero .lede {
            font-size: 1.14rem;
            color: var(--ink-soft);
            max-width: 46ch;
            margin-bottom: 32px;
        }

        .hero-actions {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .hero-stats {
            display: flex;
            gap: 32px;
            margin-top: 44px;
            padding-top: 28px;
            border-top: 1px solid var(--border-strong);
        }

            .hero-stats .stat-num {
                font-family: var(--font-display);
                font-weight: 600;
                font-size: 1.7rem;
                color: var(--oxblood);
                line-height: 1;
            }

            .hero-stats .stat-label {
                font-size: 0.84rem;
                color: var(--ink-soft);
                margin-top: 4px;
            }

        .hero-visual {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stack-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-l);
            box-shadow: var(--shadow-lift);
            padding: 26px;
            width: 100%;
            max-width: 340px;
        }

            .stack-card .row {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 12px 0;
                border-bottom: 1px solid var(--border);
            }

                .stack-card .row:last-child {
                    border-bottom: none;
                }

        .spine-chip {
            width: 34px;
            height: 46px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .stack-card .row-text .t1 {
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink);
        }

        .stack-card .row-text .t2 {
            font-size: 0.8rem;
            color: var(--ink-soft);
        }

        /* ---------- Section shell ---------- */
        .section {
            padding: 72px 0;
        }

        .section-tight {
            padding: 56px 0;
        }

        .section-alt {
            background: var(--surface);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

            .section-head p {
                color: var(--ink-soft);
                max-width: 52ch;
                margin: 10px 0 0;
            }

        /* ---------- Category pills ---------- */
        .pill-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }

        .pill {
            padding: 9px 18px;
            border-radius: 999px;
            border: 1px solid var(--border-strong);
            background: var(--surface);
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--ink-soft);
        }

            .pill:hover {
                border-color: var(--oxblood);
                color: var(--oxblood);
            }

            .pill.is-active {
                background: var(--oxblood);
                border-color: var(--oxblood);
                color: var(--surface-warm);
            }

        /* ---------- Book grid ---------- */
        .book-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 24px;
        }

        .book-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-m);
            overflow: hidden;
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

            .book-card:hover {
                transform: translateY(-4px);
                box-shadow: var(--shadow-card);
            }

        .book-spine {
            height: 150px;
            border-bottom: 3px solid var(--brass);
            display: flex;
            align-items: flex-end;
            padding: 12px 14px;
            color: var(--surface-warm);
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.92rem;
        }

        .book-card .book-info {
            padding: 16px;
        }

            .book-card .book-info .author {
                color: var(--ink-soft);
                font-size: 0.87rem;
                margin: 0;
            }

        .tag {
            display: inline-block;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--forest);
            background: #eef3ec;
            border-radius: 999px;
            padding: 3px 10px;
            margin-bottom: 9px;
        }

        /* ---------- Feature trio ---------- */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .feature-card {
            padding: 4px 0;
        }

        .feature-icon {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: var(--surface-warm);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--oxblood);
            margin-bottom: 18px;
        }

            .feature-icon svg {
                width: 20px;
                height: 20px;
            }

        .feature-card p {
            color: var(--ink-soft);
        }

        /* ---------- CTA band ---------- */
        .cta-band {
            background: var(--oxblood-dark);
            color: #ecdfd2;
            border-radius: var(--radius-l);
            padding: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            flex-wrap: wrap;
        }

            .cta-band h2 {
                color: #f4ead9;
                margin-bottom: 8px;
            }

            .cta-band p {
                color: #d9c9b8;
                margin: 0;
                max-width: 44ch;
            }

            .cta-band .btn-primary {
                background: var(--brass);
                border-color: var(--brass);
                color: #2a1a0e;
            }

                .cta-band .btn-primary:hover {
                    background: var(--brass-light);
                }

        /* ---------- Main content wrapper (interior pages) ---------- */
        .site-main {
            padding: 56px 0 72px;
            min-height: 30vh;
        }

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-m);
            padding: 28px;
            box-shadow: var(--shadow-card);
        }

        /* ---------- Footer ---------- */
        .site-footer {
            background: var(--oxblood-dark);
            color: #ecdfd2;
            margin-top: 0;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr 1.1fr;
            gap: 36px;
            padding: 60px 28px 36px;
        }

        .footer-col h4 {
            font-family: var(--font-display);
            color: var(--brass-light);
            font-size: 1rem;
            margin-bottom: 16px;
        }

        .footer-col p {
            color: #d9c9b8;
            font-size: 0.92rem;
        }

        .footer-col a {
            display: block;
            color: #ecdfd2;
            font-size: 0.92rem;
            margin-bottom: 10px;
            opacity: 0.9;
        }

            .footer-col a:hover {
                color: var(--brass-light);
                opacity: 1;
            }

        .footer-brand p {
            max-width: 32ch;
        }

        .footer-social {
            display: flex;
            gap: 10px;
            margin-top: 16px;
        }

            .footer-social a {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.18);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 0;
            }

                .footer-social a svg {
                    width: 15px;
                    height: 15px;
                }

                .footer-social a:hover {
                    border-color: var(--brass-light);
                }

        .newsletter-form {
            display: flex;
            gap: 8px;
            margin-top: 6px;
        }

            .newsletter-form input {
                flex: 1;
                padding: 10px 12px;
                border-radius: var(--radius-s);
                border: 1px solid rgba(255,255,255,0.18);
                background: rgba(255,255,255,0.06);
                color: #f4ead9;
                font-family: var(--font-body);
                font-size: 0.9rem;
            }

                .newsletter-form input::placeholder {
                    color: #c8b7a4;
                }

            .newsletter-form button {
                background: var(--brass);
                border: none;
                color: #2a1a0e;
                border-radius: var(--radius-s);
                padding: 0 16px;
                font-weight: 600;
                cursor: pointer;
            }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            padding: 18px 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

            .footer-bottom p {
                margin: 0;
                font-size: 0.82rem;
                color: #c8b7a4;
            }

        .footer-bottom-links {
            display: flex;
            gap: 18px;
        }

            .footer-bottom-links a {
                font-size: 0.82rem;
                color: #c8b7a4;
                margin: 0;
                display: inline;
            }

                .footer-bottom-links a:hover {
                    color: var(--brass-light);
                }

        /* ---------- Flash ---------- */
        .flash {
            padding: 12px 16px;
            border-radius: var(--radius-s);
            margin-bottom: 24px;
            font-size: 0.95rem;
            border: 1px solid transparent;
        }

        .flash-ok {
            background: #eef3ec;
            border-color: #cfe0c9;
            color: var(--forest);
        }

        .flash-error {
            background: #f7e9e6;
            border-color: #e6c3ba;
            color: var(--oxblood-dark);
        }

        a:focus-visible, button:focus-visible {
            outline: 2px solid var(--brass);
            outline-offset: 2px;
        }

        @@media (prefers-reduced-motion: reduce) {
            * {
                transition: none !important;
            }
        }

        /* ---------- Responsive ---------- */
        @@media (max-width: 980px) {
            .hero-inner {
                grid-template-columns: 1fr;
                padding: 56px 0 48px;
            }

            .hero-visual {
                order: -1;
            }

            .feature-grid {
                grid-template-columns: 1fr 1fr;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 760px) {
            .nav-toggle {
                display: flex;
            }

            .primary-nav {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
                flex-direction: column;
                gap: 0;
                padding: 8px 28px 16px;
            }

                .primary-nav.is-open {
                    display: flex;
                }

                .primary-nav a {
                    padding: 12px 0;
                    border-bottom: 1px solid var(--border);
                }

                    .primary-nav a::after {
                        display: none;
                    }

            .header-actions .btn-ghost {
                display: none;
            }

            h1 {
                font-size: 2.1rem;
            }

            .hero-stats {
                flex-wrap: wrap;
                gap: 22px;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .cta-band {
                padding: 34px 24px;
                flex-direction: column;
                text-align: center;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                padding: 40px 20px;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>

    <div class="top-bar">Yeni üyelere ilk ay ücretsiz — hemen kayıt olun</div>

    <header class="site-header">
        <div class="wrap header-row">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <svg class="brand-mark" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4 8c5-3 11-3 16 0v24c-5-3-11-3-16 0V8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M36 8c-5-3-11-3-16 0v24c5-3 11-3 16 0V8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                    <path d="M20 8v24" stroke="currentColor" stroke-width="1.2" />
                </svg>
                <span class="brand-text">Kütüphanem</span>
            </a>

            <button class="nav-toggle" type="button" aria-label="Menüyü aç" aria-expanded="false" aria-controls="primary-nav">
                <span></span><span></span><span></span>
            </button>

            <nav class="primary-nav" id="primary-nav">
                <a class="current" href="@Url.Action("Index", "Home")">Ana Sayfa</a>
                <a href="@Url.Action("Index", "Books")">Kitaplar</a>
                <a href="@Url.Action("Index", "Categories")">Kategoriler</a>
                <a href="@Url.Action("Index", "About")">Hakkımızda</a>
                <a href="@Url.Action("Index", "Contact")">İletişim</a>
            </nav>

            <div class="header-actions">
                <button class="search-trigger" type="button" aria-label="Ara">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
                        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </button>

                @if (Request.IsAuthenticated)
                {
                    <a class="btn btn-ghost" href="@Url.Action("Index", "Account")">Hesabım</a>
                    <a class="btn btn-primary" href="@Url.Action("LogOff", "Account")">Çıkış yap</a>
                }
                else
                {
                    <a class="btn btn-ghost" href="@Url.Action("Login", "Account")">Giriş yap</a>
                    <a class="btn btn-primary" href="@Url.Action("Register", "Account")">Üye ol</a>
                }
            </div>
        </div>
    </header>

    @{
        var pageTitle = ViewBag.Title as string;
        // Ana sayfa (Home/Index) view'ında ViewBag.ShowHero = true; ekleyin.
        // Diğer tüm sayfalarda varsayılan olarak sade başlık bandı gösterilir.
        var showHero = ViewBag.ShowHero as bool? ?? false;
    }

    @if (showHero)
    {
        <section class="hero">
            <div class="wrap hero-inner">
                <div>
                    <p class="eyebrow">Şehrin en eski koleksiyonu</p>
                    <h1>Her kitabın bir<br />raf arkadaşı vardır.</h1>
                    <p class="lede">4.200'den fazla eser, uzman kürasyonlu koleksiyonlar ve dijital üyelik ile okuma alışkanlığınızı büyütün.</p>
                    <div class="hero-actions">
                        <a class="btn btn-primary" href="@Url.Action("Index", "Books")">Kataloğu keşfet</a>
                        <a class="btn btn-ghost" href="@Url.Action("Register", "Account")">Üye ol</a>
                    </div>

                    <div class="hero-stats">
                        <div>
                            <div class="stat-num">4.200+</div>
                            <div class="stat-label">Kitap</div>
                        </div>
                        <div>
                            <div class="stat-num">1.850</div>
                            <div class="stat-label">Aktif üye</div>
                        </div>
                        <div>
                            <div class="stat-num">32</div>
                            <div class="stat-label">Kategori</div>
                        </div>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="stack-card">
                        <div class="row">
                            <div class="spine-chip" style="background:#7a2a2e;"></div>
                            <div class="row-text">
                                <div class="t1">Sessiz Ev</div>
                                <div class="t2">Orhan Pamuk</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="spine-chip" style="background:#2f4a3e;"></div>
                            <div class="row-text">
                                <div class="t1">Kürk Mantolu Madonna</div>
                                <div class="t2">Sabahattin Ali</div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="spine-chip" style="background:#a9793b;"></div>
                            <div class="row-text">
                                <div class="t1">Simyacı</div>
                                <div class="t2">Paulo Coelho</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (!string.IsNullOrEmpty(pageTitle))
    {
        <section class="hero" style="padding: 0;">
            <div class="wrap" style="padding: 48px 28px 40px;">
                <p class="eyebrow">Raflar arasında</p>
                <h1 style="font-size: 2.3rem;">@pageTitle</h1>
                @if (ViewBag.Lede != null)
                {
                    <p class="lede" style="margin-bottom:0;">@ViewBag.Lede</p>
                }
            </div>
        </section>
    }

    <main class="site-main">
        <div class="wrap">
            @if (TempData["Message"] != null)
            {
                <div class="flash flash-ok">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="flash flash-error">@TempData["Error"]</div>
            }

            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="wrap footer-grid">
            <div class="footer-col footer-brand">
                <span class="brand-text brand-text--light">Kütüphanem</span>
                <p>Şehrin en eski koleksiyonlarından yeni baskılara, her okuyucuya bir raf.</p>
                <div class="footer-social">
                    <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg></a>
                    <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4l16 16M20 4 4 20" /></svg></a>
                    <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h3v6h3v-6h3l1-3h-4V9c0-.6.4-1 1-1Z" /></svg></a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Keşfet</h4>
                <a href="@Url.Action("Index", "Books")">Kitap kataloğu</a>
                <a href="@Url.Action("Index", "Categories")">Kategoriler</a>
                <a href="@Url.Action("Register", "Account")">Üyelik koşulları</a>
            </div>

            <div class="footer-col">
                <h4>Kurumsal</h4>
                <a href="@Url.Action("Index", "About")">Hakkımızda</a>
                <a href="@Url.Action("Index", "Contact")">İletişim</a>
                <a href="#">Sıkça sorulan sorular</a>
            </div>

            <div class="footer-col">
                <h4>Bültenimize katılın</h4>
                <p>Yeni gelen kitaplar ve etkinliklerden ilk siz haberdar olun.</p>
                <form class="newsletter-form" onsubmit="return false;">
                    <input type="email" placeholder="E-posta adresiniz" />
                    <button type="submit">Katıl</button>
                </form>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Kütüphanem. Tüm hakları saklıdır.</p>
            <div class="footer-bottom-links">
                <a href="#">Gizlilik</a>
                <a href="#">Kullanım Şartları</a>
                <a href="#">Çerezler</a>
            </div>
        </div>
    </footer>

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script>document.addEventListener("DOMContentLoaded", function () {
            var toggle = document.querySelector(".nav-toggle");
            var nav = document.getElementById("primary-nav");
            if (!toggle || !nav) return;
            toggle.addEventListener("click", function () {
                var isOpen = nav.classList.toggle("is-open");
                toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
            });
        });</script>
    @RenderSection("scripts", required: false)
</body>
</html>
