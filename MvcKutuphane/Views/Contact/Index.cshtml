@{
    ViewBag.Title = "İletişim";
    ViewBag.Lede = "Sorularınız, önerileriniz veya iş birliği talepleriniz için bize ulaşın.";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}

<style>
    .contact-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 48px;
        align-items: start;
    }

    .contact-info-list {
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin-bottom: 32px;
    }

    .contact-info-item {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .contact-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--surface-warm);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--oxblood);
        flex-shrink: 0;
    }

        .contact-icon svg {
            width: 19px;
            height: 19px;
        }

    .contact-info-item h4 {
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .contact-info-item p {
        color: var(--ink-soft);
        margin: 0;
        font-size: 0.94rem;
    }

    .hours-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 8px;
    }

        .hours-table td {
            padding: 8px 0;
            font-size: 0.9rem;
            color: var(--ink-soft);
            border-bottom: 1px solid var(--border);
        }

        .hours-table tr:last-child td {
            border-bottom: none;
        }

        .hours-table td:first-child {
            color: var(--ink);
            font-weight: 500;
        }

        .hours-table td:last-child {
            text-align: right;
        }

    .contact-form-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-l);
        padding: 36px;
        box-shadow: var(--shadow-card);
    }

    .form-row-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-family: var(--font-display);
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-s);
            background: var(--surface);
            font-family: var(--font-body);
            font-size: 0.98rem;
            color: var(--ink);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 130px;
            line-height: 1.5;
        }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus {
                outline: none;
                border-color: var(--oxblood);
            }

    .map-panel {
        margin-top: 24px;
        border-radius: var(--radius-m);
        overflow: hidden;
        border: 1px solid var(--border);
        height: 200px;
    }

        .map-panel iframe {
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
        }

    @@media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .form-row-2 {
            grid-template-columns: 1fr;
        }

        .contact-form-panel {
            padding: 24px;
        }
    }
</style>

<div class="contact-grid">

    <div>
        <div class="contact-info-list">
            <div class="contact-info-item">
                <div class="contact-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.6">
                        <path d="M12 21s-7-6.1-7-11a7 7 0 0 1 14 0c0 4.9-7 11-7 11Z" />
                        <circle cx="12" cy="10" r="2.5" />
                    </svg>
                </div>
                <div>
                    <h4>Adres</h4>
                    <p>Merkez Kütüphane, Kitapçılar Sokak No:12, İstanbul</p>
                </div>
            </div>

            <div class="contact-info-item">
                <div class="contact-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.6">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92Z" />
                    </svg>
                </div>
                <div>
                    <h4>Telefon</h4>
                    <p>+90 212 555 01 23</p>
                </div>
            </div>

            <div class="contact-info-item">
                <div class="contact-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" stroke-width="1.6">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                </div>
                <div>
                    <h4>E-posta</h4>
                    <p>info@kutuphanem.com</p>
                </div>
            </div>
        </div>

        <div class="panel">
            <h3 style="font-size: 1.05rem; margin-bottom: 14px;">Çalışma Saatleri</h3>
            <table class="hours-table">
                <tr><td>Pazartesi – Cuma</td><td>09:00 – 20:00</td></tr>
                <tr><td>Cumartesi</td><td>10:00 – 17:00</td></tr>
                <tr><td>Pazar</td><td>Kapalı</td></tr>
            </table>
        </div>

        <div class="map-panel">
            <iframe src="https://www.google.com/maps?q=istanbul&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>

    <div class="contact-form-panel">
        <h2 style="font-size: 1.5rem; margin-bottom: 8px;">Bize yazın</h2>
        <p style="color: var(--ink-soft); margin-bottom: 28px;">Formu doldurun, en kısa sürede size dönüş yapalım.</p>

        @if (TempData["Message"] != null)
        {
            <div class="flash flash-ok" style="margin-bottom: 20px;">@TempData["Message"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="flash flash-error" style="margin-bottom: 20px;">@TempData["Error"]</div>
        }

        @using (Html.BeginForm("Index", "Contact", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-row-2">
                <div class="form-group">
                    <label for="AdSoyad">Ad Soyad</label>
                    <input type="text" name="ADSOYAD" id="AdSoyad" placeholder="Adınız Soyadınız" autocomplete="off" />
                </div>
                <div class="form-group">
                    <label for="Email">E-posta</label>
                    <input type="email" name="MAIL" id="Email" placeholder="ornek@mail.com" autocomplete="off" />
                </div>
            </div>

            <div class="form-group">
                <label for="Konu">Konu</label>
                <input type="text" name="KONU" id="Konu" placeholder="Örn: Üyelik, kitap talebi, teknik sorun..." autocomplete="off" />
            </div>

            <div class="form-group">
                <label for="Mesaj">Mesajınız</label>
                <textarea name="MESAJ" id="Mesaj" placeholder="Mesajınızı buraya yazın..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary">Mesajı gönder</button>
        }
    </div>

</div>
