@model List<MvcKutuphane.Models.Entities.TBL_CEZALAR>

@{
    ViewBag.Title = "Cezalarım";
    Layout = "~/Views/Shared/_MemberLayout.cshtml";

    var toplamCeza = Model != null ? Model.Count : 0;

    decimal toplamTutar = 0;

    if (Model != null)
    {
        toplamTutar = Model.Sum(x => x.CEZA ?? 0);
    }
}

<style>
    .penalty-page {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    /* HEADER */
    .penalty-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .penalty-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--brass);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .penalty-eyebrow-line {
        width: 28px;
        height: 1px;
        background: var(--brass);
    }

    .penalty-header h1 {
        margin: 0 0 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 2.15rem;
        line-height: 1.15;
    }

    .penalty-header p {
        margin: 0;
        max-width: 650px;
        color: var(--ink-soft);
        font-size: 0.94rem;
        line-height: 1.6;
    }

    /* STATS */
    .penalty-stats {
        display: flex;
        gap: 10px;
    }

    .penalty-stat {
        min-width: 125px;
        padding: 13px 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
        box-shadow: var(--shadow-card);
    }

        .penalty-stat span {
            display: block;
            margin-bottom: 4px;
            color: var(--ink-soft);
            font-size: 0.67rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .penalty-stat strong {
            color: var(--oxblood);
            font-family: var(--font-display);
            font-size: 1.35rem;
            line-height: 1;
        }

        .penalty-stat.money strong {
            color: var(--brass);
        }

    /* LIST */
    .penalty-list {
        display: grid;
        gap: 16px;
    }

    /* CARD */
    .penalty-card {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .penalty-card::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: var(--oxblood);
        }

        .penalty-card:hover {
            transform: translateY(-3px);
            border-color: #d8c9bb;
            box-shadow: 0 14px 32px rgba(42, 33, 28, 0.09);
        }

    .penalty-inner {
        padding: 22px 24px 20px 29px;
    }

    /* META */
    .penalty-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 17px;
        flex-wrap: wrap;
    }

    .penalty-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--oxblood);
        font-size: 0.71rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

        .penalty-label svg {
            width: 17px;
            height: 17px;
        }

    .penalty-id {
        color: var(--ink-soft);
        font-size: 0.74rem;
        opacity: 0.8;
    }

    /* TITLE */
    .penalty-title {
        margin: 0 0 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.3rem;
        line-height: 1.35;
    }

    .penalty-description {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.91rem;
        line-height: 1.7;
    }

    /* INFO */
    .penalty-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 11px;
        margin-top: 20px;
    }

    .penalty-info-box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: var(--surface-warm);
        border: 1px solid var(--border);
        border-radius: var(--radius-s);
    }

        .penalty-info-box.amount {
            background: #fbf4e8;
            border-color: #e9d9bd;
        }

    .penalty-info-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--brass);
        background: #f5ecdf;
        border-radius: 50%;
    }

    .penalty-info-box.amount .penalty-info-icon {
        color: var(--oxblood);
        background: #f4e3df;
    }

    .penalty-info-icon svg {
        width: 17px;
        height: 17px;
    }

    .penalty-info-text {
        min-width: 0;
    }

        .penalty-info-text span {
            display: block;
            margin-bottom: 2px;
            color: var(--ink-soft);
            font-size: 0.64rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .penalty-info-text strong {
            display: block;
            color: var(--ink);
            font-size: 0.86rem;
            font-weight: 650;
            white-space: nowrap;
        }

    .penalty-info-box.amount .penalty-info-text strong {
        color: var(--oxblood);
    }

    /* FOOTER */
    .penalty-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding-top: 14px;
        border-top: 1px solid var(--border);
        color: var(--ink-soft);
        font-size: 0.75rem;
        flex-wrap: wrap;
    }

        .penalty-footer svg {
            width: 14px;
            height: 14px;
            color: var(--brass);
            vertical-align: middle;
            margin-right: 5px;
        }

    /* EMPTY */
    .penalty-empty {
        position: relative;
        overflow: hidden;
        text-align: center;
        padding: 76px 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-m);
        box-shadow: var(--shadow-card);
    }

        .penalty-empty::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            top: -130px;
            right: -80px;
            border-radius: 50%;
            background: rgba(47, 74, 62, 0.05);
        }

        .penalty-empty::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            bottom: -110px;
            left: -70px;
            border-radius: 50%;
            background: rgba(181, 143, 74, 0.05);
        }

    .penalty-empty-icon {
        position: relative;
        z-index: 1;
        width: 68px;
        height: 68px;
        margin: 0 auto 19px;
        border-radius: 50%;
        background: #edf3ee;
        color: var(--forest);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .penalty-empty-icon svg {
            width: 31px;
            height: 31px;
        }

    .penalty-empty h3 {
        position: relative;
        z-index: 1;
        margin: 0 0 8px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 1.35rem;
    }

    .penalty-empty p {
        position: relative;
        z-index: 1;
        max-width: 450px;
        margin: 0 auto;
        color: var(--ink-soft);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    /* RESPONSIVE */
    @@media (max-width: 850px) {
        .penalty-info {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .penalty-page {
            padding-bottom: 25px;
        }

        .penalty-header {
            align-items: flex-start;
            margin-bottom: 22px;
        }

            .penalty-header h1 {
                font-size: 1.75rem;
            }

        .penalty-stats {
            width: 100%;
        }

        .penalty-stat {
            flex: 1;
            min-width: 0;
        }

        .penalty-inner {
            padding: 19px 18px 18px 22px;
        }

        .penalty-title {
            font-size: 1.14rem;
        }

        .penalty-description {
            font-size: 0.89rem;
        }
    }

    @@media (max-width: 420px) {

        .penalty-header h1 {
            font-size: 1.55rem;
        }

        .penalty-inner {
            padding-left: 19px;
        }

        .penalty-stat {
            padding: 11px;
        }

            .penalty-stat strong {
                font-size: 1.15rem;
            }
    }
</style>


<div class="penalty-page">

    <!-- HEADER -->
    <div class="penalty-header">

        <div>

            <div class="penalty-eyebrow">
                <span class="penalty-eyebrow-line"></span>
                Hesabım
            </div>

            <h1>Cezalarım</h1>

            <p>
                Ödünç işlemlerinizden kaynaklanan ceza kayıtlarını
                ve ilgili tarih ve tutar bilgilerini buradan takip edebilirsiniz.
            </p>

        </div>

        <div class="penalty-stats">

            <div class="penalty-stat">
                <span>Toplam Kayıt</span>
                <strong>@toplamCeza</strong>
            </div>

            <div class="penalty-stat money">
                <span>Toplam Tutar</span>
                <strong>@toplamTutar.ToString("N2") ₺</strong>
            </div>

        </div>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="penalty-list">

            @foreach (var ceza in Model)
            {
                <article class="penalty-card">

                    <div class="penalty-inner">

                        <!-- META -->
                        <div class="penalty-meta">

                            <div class="penalty-label">

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <path d="M12 3l9 4.5v5.8c0 4.2-3.2 6.8-9 8.7-5.8-1.9-9-4.5-9-8.7V7.5L12 3Z"
                                          stroke="currentColor"
                                          stroke-width="1.5"
                                          stroke-linejoin="round" />

                                    <path d="M12 8v4"
                                          stroke="currentColor"
                                          stroke-width="1.6"
                                          stroke-linecap="round" />

                                    <circle cx="12"
                                            cy="15.5"
                                            r=".8"
                                            fill="currentColor" />

                                </svg>

                                Ceza Kaydı

                            </div>

                            <span class="penalty-id">
                                Kayıt #@ceza.ID
                            </span>

                        </div>


                        <!-- TITLE -->
                        <h2 class="penalty-title">
                            Kütüphane Ceza İşlemi
                        </h2>

                        <p class="penalty-description">
                            Ödünç işlemine bağlı olarak oluşturulan ceza kaydı.
                        </p>


                        <!-- BİLGİLER -->
                        <div class="penalty-info">

                            <!-- BAŞLANGIÇ -->
                            <div class="penalty-info-box">

                                <div class="penalty-info-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">

                                        <rect x="3.5"
                                              y="5"
                                              width="17"
                                              height="15"
                                              rx="2"
                                              stroke="currentColor"
                                              stroke-width="1.5" />

                                        <path d="M7 3.5v3M17 3.5v3M3.5 9h17"
                                              stroke="currentColor"
                                              stroke-width="1.5"
                                              stroke-linecap="round" />

                                    </svg>

                                </div>

                                <div class="penalty-info-text">

                                    <span>Ceza Başlangıç</span>

                                    <strong>
                                        @(
                                            ceza.CEZABASLANGIC.HasValue
                                                ? ceza.CEZABASLANGIC.Value.ToString("dd.MM.yyyy")
                                                : "Belirtilmemiş"
                                        )
                                    </strong>

                                </div>

                            </div>


                            <!-- BİTİŞ -->
                            <div class="penalty-info-box">

                                <div class="penalty-info-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">

                                        <path d="M4 12h16"
                                              stroke="currentColor"
                                              stroke-width="1.5"
                                              stroke-linecap="round" />

                                        <path d="m13 7 5 5-5 5"
                                              stroke="currentColor"
                                              stroke-width="1.5"
                                              stroke-linecap="round"
                                              stroke-linejoin="round" />

                                    </svg>

                                </div>

                                <div class="penalty-info-text">

                                    <span>Ceza Bitiş</span>

                                    <strong>
                                        @(
                                            ceza.CEZABITIS.HasValue
                                                ? ceza.CEZABITIS.Value.ToString("dd.MM.yyyy")
                                                : "Devam ediyor"
                                        )
                                    </strong>

                                </div>

                            </div>


                            <!-- TUTAR -->
                            <div class="penalty-info-box amount">

                                <div class="penalty-info-icon">

                                    <svg viewBox="0 0 24 24"
                                         fill="none"
                                         xmlns="http://www.w3.org/2000/svg">

                                        <path d="M12 3v18"
                                              stroke="currentColor"
                                              stroke-width="1.5"
                                              stroke-linecap="round" />

                                        <path d="M16.5 7H9.8a2.8 2.8 0 0 0 0 5.6h4.4a2.8 2.8 0 0 1 0 5.6H7"
                                              stroke="currentColor"
                                              stroke-width="1.5"
                                              stroke-linecap="round" />

                                    </svg>

                                </div>

                                <div class="penalty-info-text">

                                    <span>Ceza Tutarı</span>

                                    <strong>
                                        @ceza.CEZA ₺
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- FOOTER -->
                        <div class="penalty-footer">

                            <span>

                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     xmlns="http://www.w3.org/2000/svg">

                                    <circle cx="12"
                                            cy="12"
                                            r="8.5"
                                            stroke="currentColor"
                                            stroke-width="1.5" />

                                    <path d="M12 7v5l3 2"
                                          stroke="currentColor"
                                          stroke-width="1.5"
                                          stroke-linecap="round" />

                                </svg>

                                Ceza kaydı sistem üzerinde tutulmaktadır.

                            </span>

                            <span>
                                Kayıt No: @ceza.ID
                            </span>

                        </div>

                    </div>

                </article>
            }

        </div>
    }
    else
    {
        <!-- EMPTY -->
        <div class="penalty-empty">

            <div class="penalty-empty-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M12 3l9 4.5v5.8c0 4.2-3.2 6.8-9 8.7-5.8-1.9-9-4.5-9-8.7V7.5L12 3Z"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linejoin="round" />

                    <path d="M8 12l2.5 2.5L16 9"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round" />

                </svg>

            </div>

            <h3>Herhangi bir cezanız bulunmuyor</h3>

            <p>
                Hesabınızda kayıtlı herhangi bir ceza kaydı bulunmamaktadır.
                Kitap işlemlerinizi güvenle sürdürebilirsiniz.
            </p>

        </div>
    }

</div>
